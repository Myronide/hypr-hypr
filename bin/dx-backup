#!/usr/bin/env python3
"""Draconyx: Einstellungen sichern und wiederherstellen (ein Archiv mit allem, was zu deinem Setup gehört).
  dx-backup create [NAME]        Sicherung anlegen (Standard-Ordner: ~/Documents/Draconyx-Backups)
  dx-backup list [--json]        vorhandene Sicherungen
  dx-backup restore DATEI        wiederherstellen (vorher wird der jetzige Stand automatisch gesichert)
  dx-backup auto                 höchstens einmal pro Woche automatisch sichern, die letzten 10 behalten
  dx-backup delete DATEI         eine Sicherung löschen
Enthalten: Shell-Einstellungen (Taskleiste, angeheftete Apps, Desktop-Symbole …), Farben/Schrift/Terminal/Tastaturbelegung/Tastenkombinationen,
Aurora-Einstellungen, Monitore, Fenster-Regeln, Autostart, Hyprland-Konfiguration. Keine Programme, keine Wallpaper-Dateien."""
import json, os, subprocess, sys, tarfile, time
from pathlib import Path

HOME = Path.home()
DIR = HOME / "Documents/Draconyx-Backups"
INCLUDE = [
    ".config/draconyx", ".local/state/draconyx/settings.json", ".local/share/draconyx-apps/installed.json",
    ".config/hypr/hyprland.lua", ".config/hypr/monitors_local.lua", ".config/hypr/csd-apps", ".config/hypr/hypridle.conf",
    ".config/hypr/hyprlock.conf", ".config/hypr/aurora/preferences.json", ".config/hypr/aurora/preferences.lua",
    ".config/hypr/aurora/pins.json", ".config/autostart", ".config/gtk-3.0/settings.ini", ".config/gtk-4.0/settings.ini",
]
EXCLUDE_SUFFIX = (".tmp", ".lock", ".pid")


def version():
    try:
        return json.loads((HOME / ".config/draconyx/install.json").read_text()).get("version", "?")
    except (OSError, ValueError):
        return "?"


def create(name=""):
    DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = DIR / ("draconyx-%s%s.tar.gz" % (stamp, ("-" + name.replace("/", "_").replace(" ", "_")) if name else ""))
    manifest = {"version": version(), "created": int(time.time()), "host": os.uname().nodename, "files": []}
    with tarfile.open(out, "w:gz") as tar:
        for rel in INCLUDE:
            p = HOME / rel
            if not p.exists():
                continue
            if p.is_dir():
                for f in sorted(p.rglob("*")):
                    if f.is_file() and not f.name.endswith(EXCLUDE_SUFFIX) and not f.is_symlink():
                        tar.add(f, arcname=str(f.relative_to(HOME))); manifest["files"].append(str(f.relative_to(HOME)))
            else:
                tar.add(p, arcname=rel); manifest["files"].append(rel)
        data = json.dumps(manifest, indent=2, ensure_ascii=False).encode()
        info = tarfile.TarInfo("backup.json"); info.size = len(data); info.mtime = int(time.time())
        import io
        tar.addfile(info, io.BytesIO(data))
    return out


def info(path):
    try:
        with tarfile.open(path) as tar:
            f = tar.extractfile("backup.json")
            m = json.loads(f.read()) if f else {}
    except (OSError, tarfile.TarError, ValueError, KeyError):
        m = {}
    st = Path(path).stat()
    return {"path": str(path), "name": Path(path).name, "size": st.st_size, "mtime": int(st.st_mtime),
            "version": m.get("version", "?"), "files": len(m.get("files", []))}


def listing():
    if not DIR.exists():
        return []
    return [info(p) for p in sorted(DIR.glob("*.tar.gz"), key=lambda p: -p.stat().st_mtime)]


def safe_members(tar):
    for m in tar.getmembers():
        n = m.name
        if m.name == "backup.json":
            continue
        if n.startswith("/") or ".." in Path(n).parts or not (m.isfile() or m.isdir()):
            continue
        if not any(n == r or n.startswith(r + "/") for r in INCLUDE):
            continue
        yield m


def restore(path):
    path = Path(path)
    if not path.is_file():
        print("Datei nicht gefunden:", path, file=sys.stderr); return 1
    before = create("vor-wiederherstellung")
    print("Jetziger Stand gesichert:", before)
    with tarfile.open(path) as tar:
        members = list(safe_members(tar))
        tar.extractall(HOME, members=members)
    print("%d Dateien wiederhergestellt" % len(members))
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    return 0


def auto():
    L = listing()
    autos = [x for x in L if "-auto" in x["name"]]
    if autos and time.time() - autos[0]["mtime"] < 7 * 86400:
        return
    create("auto")
    autos = [x for x in listing() if "-auto" in x["name"]]
    for x in autos[10:]:
        Path(x["path"]).unlink(missing_ok=True)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "list"
    if cmd == "create":
        print(create(a[1] if len(a) > 1 else ""))
    elif cmd == "list":
        L = listing()
        if "--json" in a:
            print(json.dumps(L, ensure_ascii=False))
        else:
            for x in L:
                print("%s  v%s  %d Dateien  %.1f KB" % (x["name"], x["version"], x["files"], x["size"] / 1024))
    elif cmd == "restore" and len(a) == 2:
        sys.exit(restore(a[1]))
    elif cmd == "auto":
        auto()
    elif cmd == "delete" and len(a) == 2:
        p = Path(a[1])
        if p.parent == DIR and p.name.endswith(".tar.gz"):
            p.unlink(missing_ok=True)
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
