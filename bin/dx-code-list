#!/usr/bin/env bash
# Hypr Hypr Coding Space: listet Unterordner als Projekt oder Workspace.
#   dx-code-list <ordner> [<ordner-mit-weiteren-*Workspace*-Ordnern>]
# Ausgabe (TSV): geändert<TAB>art<TAB>git<TAB>name<TAB>pfad     (art = project | workspace)
# dx-code-list --mark <pfad> workspace|project|auto : Handarbeit festhalten (auto = wieder automatisch erkennen)
if [ "${1:-}" = "--mark" ]; then
  path="${2:-}"; kind="${3:-}"; path="${path%/}"
  [ -n "$path" ] && [ -d "$path" ] && case "$kind" in workspace|project|auto) true;; *) false;; esac || { echo "Benutzung: dx-code-list --mark <ordner> workspace|project|auto" >&2; exit 2; }
  conf="${XDG_CONFIG_HOME:-$HOME/.config}/draconyx"; mkdir -p "$conf"
  for f in code-workspaces code-projects; do
    [ -f "$conf/$f" ] || continue
    tmp=$(mktemp "$conf/.$f.XXXXXX") && { grep -vxF -- "$path" "$conf/$f" > "$tmp" || true; mv -f "$tmp" "$conf/$f"; }
  done
  case "$kind" in workspace) echo "$path" >> "$conf/code-workspaces";; project) echo "$path" >> "$conf/code-projects";; esac
  exit 0
fi
dir="${1:-}"; extra="${2:-}"
[ -n "$dir" ] && [ -d "$dir" ] || { echo "Benutzung: dx-code-list <ordner> [<ordner-mit-Workspaces>]" >&2; exit 2; }   # leer = sonst würde "/" aufgelistet

# Workspace oder Projekt? Reihenfolge:
#   1. Handarbeit: Pfad steht in ~/.config/draconyx/code-workspaces bzw. code-projects (eine Zeile je Pfad)
#   2. "Workspace" im Namen -> Workspace (Namen sind nicht nötig, aber weiter erlaubt)
#   3. Ordner mit Projektmerkmal (.git, pom.xml, package.json, Cargo.toml, ...) -> Projekt
#   4. Ordner ohne Merkmal, in dem mindestens ein Projekt liegt -> Workspace
#   5. sonst -> Projekt (ein gewöhnlicher Ordner, lässt sich als Ordner öffnen)
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/draconyx"
listed() { [ -f "$1" ] && grep -qxF -- "$2" "$1"; }
has_marker() {
  local d="$1" m
  for m in .git pom.xml build.gradle build.gradle.kts settings.gradle settings.gradle.kts package.json Cargo.toml go.mod pyproject.toml \
           CMakeLists.txt .idea composer.json Makefile pubspec.yaml Gemfile mix.exs deno.json; do
    [ -e "$d/$m" ] && return 0
  done
  compgen -G "$d/*.sln" >/dev/null && return 0
  compgen -G "$d/*.csproj" >/dev/null && return 0
  compgen -G "$d/*.iml" >/dev/null && return 0
  return 1
}
has_project_child() {
  local c n=0
  for c in "$1"/*/; do
    [ -d "$c" ] || continue
    has_marker "${c%/}" && return 0
    n=$((n+1)); [ "$n" -ge 60 ] && break      # bei riesigen Ordnern nicht ewig suchen
  done
  return 1
}
classify() {
  local p="${1%/}" n; n=$(basename "$p")
  if listed "$CONF/code-workspaces" "$p"; then echo workspace; return; fi
  if listed "$CONF/code-projects" "$p"; then echo project; return; fi
  case "${n,,}" in *workspace*) echo workspace; return;; esac
  if has_marker "$p"; then echo project; return; fi
  if has_project_child "$p"; then echo workspace; else echo project; fi
}
emit() {
  local p="$1" k="$2" g=0
  [ -e "$p/.git" ] && g=1             # .git ist bei Worktrees/Submodulen eine Datei
  printf '%s\t%s\t%s\t%s\t%s\n' "$(stat -c %Y "$p" 2>/dev/null || echo 0)" "$k" "$g" "$(basename "$p")" "$p"
}
{
  if [ -n "$extra" ]; then
    for p in "$extra"/*/; do
      [ -d "$p" ] || continue; p="${p%/}"
      [ "$p" = "$dir" ] && continue
      [ "$(classify "$p")" = workspace ] && emit "$p" workspace
    done
  fi
  for p in "$dir"/*/; do
    [ -d "$p" ] || continue
    p="${p%/}"
    emit "$p" "$(classify "$p")"
  done
  # Weitere Ordner (Einstellungen → Coding Space): ein Projekt (Git/Projektmerkmal) bleibt ein Projekt, jeder andere Ordner ist ein Workspace – der Name ist egal
  IFS=: read -ra more <<< "${DX_CODE_ROOTS:-}"
  for r in "${more[@]}"; do
    r="${r%/}"; [ -d "$r" ] || continue
    if listed "$CONF/code-projects" "$r"; then emit "$r" project
    elif has_marker "$r" && ! listed "$CONF/code-workspaces" "$r"; then emit "$r" project
    else emit "$r" workspace
    fi
  done
} | awk -F'\t' '!seen[$5]++' | sort -t$'\t' -k2,2r -k1,1nr
