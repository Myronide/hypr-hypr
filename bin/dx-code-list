#!/usr/bin/env bash
# Draconyx Coding Space: listet Unterordner als Projekt oder Workspace.
#   dx-code-list <ordner> [<ordner-mit-weiteren-*Workspace*-Ordnern>]
# Ausgabe (TSV): geändert<TAB>art<TAB>git<TAB>name<TAB>pfad     (art = project | workspace)
dir="$1"; extra="${2:-}"

# Workspace = Ordner mit "Workspace" im Namen. Alles andere ist ein Projekt (keine weiteren Vermutungen).
classify() {
  local n; n=$(basename "$1")
  case "${n,,}" in *workspace*) echo workspace;; *) echo project;; esac
}
emit() {
  local p="$1" k="$2" g=0
  [ -d "$p/.git" ] && g=1
  printf '%s\t%s\t%s\t%s\t%s\n' "$(stat -c %Y "$p" 2>/dev/null || echo 0)" "$k" "$g" "$(basename "$p")" "$p"
}
{
  if [ -n "$extra" ]; then
    for p in "$extra"/*[Ww]orkspace*/; do [ -d "$p" ] && emit "${p%/}" workspace; done
  fi
  for p in "$dir"/*/; do
    [ -d "$p" ] || continue
    p="${p%/}"
    emit "$p" "$(classify "$p")"
  done
  # Weitere Ordner (Einstellungen → Coding Space): Git-Projekt = ein Projekt, "Workspace" im Namen = ein Workspace, sonst Unterordner
  IFS=: read -ra more <<< "${DX_CODE_ROOTS:-}"
  for r in "${more[@]}"; do
    r="${r%/}"; [ -d "$r" ] || continue
    if [ -d "$r/.git" ]; then emit "$r" project
    elif case "$(basename "$r" | tr A-Z a-z)" in *workspace*) true;; *) false;; esac; then emit "$r" workspace
    else
      for p in "$r"/*/; do [ -d "$p" ] && { p="${p%/}"; emit "$p" "$(classify "$p")"; }; done
    fi
  done
} | awk -F'\t' '!seen[$5]++' | sort -t$'\t' -k2,2r -k1,1nr
