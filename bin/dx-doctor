#!/usr/bin/env bash
# Draconyx/Aurora: Zustandsbericht für die Fehlersuche (alles in eine Datei: ~/dx-doctor.txt) und optional Aufräumen.
#   dx-doctor          Bericht schreiben und anzeigen
#   dx-doctor --fix    zusätzlich Doppelstarts beenden (waybar, altes Aurora-Dock) und alte Socket-Reste entfernen
OUT="$HOME/dx-doctor.txt"; FIX=0; [ "$1" = "--fix" ] && FIX=1
H="$HOME/.config/hypr"
sec() { printf '\n===== %s =====\n' "$1"; }
{
echo "dx-doctor $(date '+%F %T')  user=$USER"
sec "System"
uname -sr; hyprctl version 2>/dev/null | head -1; qs --version 2>/dev/null | head -1; echo "Sitzung: ${XDG_CURRENT_DESKTOP:-?} / ${XDG_SESSION_TYPE:-?}  Instanz: ${HYPRLAND_INSTANCE_SIGNATURE:-keine}"
sec "Laufende Prozesse (relevante)"
for n in qs waybar swaync hypridle linux-wallpaper; do printf '%-16s %s\n' "$n" "$(pgrep -x "$n" | tr '\n' ' ')"; done
for p in $(pgrep -x python3 2>/dev/null); do c=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null); case "$c" in *desktop-ui*|*dx-ui-bridge*|*dx-x11-iconify*|*settings-app*) echo "python3 $p: $c";; esac; done
echo "qs-Prozesse: $(pgrep -xc qs)  (mehr als 1 = doppelt gestartet)"
n_ic=0; n_br=0
for p in $(pgrep -x python3 2>/dev/null); do c=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null); case "$c" in *dx-x11-iconify*) n_ic=$((n_ic+1));; *dx-ui-bridge*) n_br=$((n_br+1));; esac; done
echo "dx-x11-iconify: $n_ic (soll 1)   dx-ui-bridge: $n_br (soll 1)"
command -v xdotool >/dev/null && echo "xdotool: ja" || echo "xdotool: FEHLT (Minimieren von XWayland-Apps braucht es)"
sec "Wallpaper Engine"
P="$HOME/.local/opt/linux-wallpaperengine"
[ -x "$P/linux-wallpaperengine" ] && echo "Engine gebaut: ja ($(stat -c %y "$P/linux-wallpaperengine" | cut -d. -f1))" || echo "Engine gebaut: NEIN ($P)"
echo "Gewählt (settings.json): $(jq -c .weWallpapers "$HOME/.local/state/draconyx/settings.json" 2>/dev/null)"
echo "Läuft: $(pgrep -ax linux-wallpaper | grep -v -- '--type=' | cut -c1-400)"
echo "Aurora-Renderer (alt): $(pgrep -f '[a]urora/native/wallpaper/aurora-wallpaper' | tr '\n' ' ')"
echo "Andere Hintergrund-Programme: $(for n in hyprpaper swww-daemon swaybg mpvpaper wpaperd; do pgrep -x $n >/dev/null && printf '%s ' $n; done)"
echo "we-assets-Datei: $(head -1 "$HOME/.config/draconyx/we-assets" 2>/dev/null)"
echo "Assets in Aurora-Einstellung: $(jq -r .engine_assets "$H/aurora/preferences.json" 2>/dev/null)"
echo "Steam-Bibliotheken:"; grep -h '"path"' "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" "$HOME/.steam/steam/steamapps/libraryfolders.vdf" 2>/dev/null | sort -u
echo "Durchsuchte Workshop-Ordner:"; "$HOME/.local/bin/dx-we-list" --roots 2>&1 | head -12
echo "GPU/OpenGL: $(lspci 2>/dev/null | grep -iE 'vga|3d' | cut -d: -f3 | tr '\n' ';')"
echo "--- Engine-Log (letzte 25 Zeilen) ---"; tail -25 "${XDG_RUNTIME_DIR:-/tmp}/draconyx-we.log" 2>/dev/null | cut -c1-200
sec "Hyprland: Konfigurationsfehler / Plugins / Monitore"
hyprctl configerrors 2>&1 | head -12
hyprctl plugin list 2>&1 | grep -E '^Plugin' | head
hyprctl monitors -j 2>/dev/null | jq -r '.[]|"\(.name) \(.width)x\(.height)@\(.refreshRate) pos=\(.x),\(.y) scale=\(.scale) reserved=\(.reserved)"' 2>/dev/null
sec "Was lädt deine hyprland.lua?"
grep -nE 'require|dofile|source|desktop\.lua|aurora|draconyx|exec_cmd\(.*(waybar|qs|desktop-ui|start-)' "$H/hyprland.lua" 2>/dev/null | head -30
sec "Dateien"
for f in "$H/hyprland.lua" "$H/aurora/desktop.lua" "$H/monitors_local.lua" "$H/dx_binds.lua" "$H/aurora/preferences.json" "$H/aurora/preferences.lua" "$H/aurora/desktop-ui" "$H/aurora/start-desktop" "$H/aurora/start-dock" "$HOME/.config/quickshell/draconyx/shell.qml" "$HOME/.config/draconyx/modifier" "$HOME/.config/draconyx/terminal" "$HOME/.config/draconyx/colors.json" "$HOME/.config/draconyx/binds.conf" "$HOME/.local/state/draconyx/settings.json" "$HOME/.local/opt/linux-wallpaperengine/linux-wallpaperengine"; do
  if [ -e "$f" ]; then printf '%-70s %s\n' "${f/#$HOME/~}" "$(stat -c '%y' "$f" | cut -c1-16)"; else printf '%-70s fehlt\n' "${f/#$HOME/~}"; fi
done
sec "Aurora-Einstellungen (Auszug)"
[ -f "$H/aurora/preferences.json" ] && jq -c '{dock_monitor,workshop,engine_assets,engine_path,engine_active,terminal}' "$H/aurora/preferences.json" 2>/dev/null
sec "Shell-Einstellungen (Auszug)"
jq -c '{barStyle,barHeight,autohide,barPartHide,fullscreenBar,monitors,desktopMonitors,codeRoot}' "$HOME/.local/state/draconyx/settings.json" 2>/dev/null
sec "Shell-Log: Fehler und Warnungen (letzte 25)"
qs -c draconyx log 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -aE 'ERROR|WARN scene|caused by' | grep -v 'PlatformMenu\|textinput' | tail -25
sec "Shell-Start (Sicherheitsnetz dx-shell-ensure)"
[ -x "$HOME/.local/bin/dx-shell-ensure" ] && echo "dx-shell-ensure: vorhanden" || echo "dx-shell-ensure: FEHLT"
tail -8 "$HOME/.cache/draconyx/shell-start.log" 2>/dev/null || echo "(noch kein Eintrag – die Shell ist beim Start ohne Hilfe angesprungen oder das Netz lief nicht)"
grep -n 'hyprland.start' "$H/aurora/desktop.lua" 2>/dev/null | head -3
sec "Aurora-Logs (letzte Zeilen)"
for l in "$HOME"/.cache/aurora/*.log; do [ -f "$l" ] && { echo "--- $l"; tail -4 "$l"; }; done 2>/dev/null
sec "Wallpaper-Suche"
"$HOME/.local/bin/dx-we-list" --roots 2>&1 | head -8
} > "$OUT" 2>&1
if [ "$FIX" = 1 ]; then
  echo "== Aufräumen ==" | tee -a "$OUT"
  pgrep -x waybar >/dev/null && { pkill -x waybar; echo "waybar beendet" | tee -a "$OUT"; }
  for p in $(pgrep -x python3); do tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q 'desktop-ui daemon' && { kill "$p"; echo "altes Aurora-Dock beendet ($p)" | tee -a "$OUT"; }; done
  # doppelte Wächter: nur den neuesten behalten
  for n in dx-x11-iconify dx-ui-bridge; do ids=$(for p in $(pgrep -x python3); do tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q "$n" && echo $p; done | sort -n); keep=$(echo "$ids" | tail -1); for p in $ids; do [ "$p" != "$keep" ] && { kill "$p"; echo "doppelten $n beendet ($p)" | tee -a "$OUT"; }; done; done
  rm -f "${XDG_RUNTIME_DIR:-/tmp}"/aurora-dock.lock "${XDG_RUNTIME_DIR:-/tmp}"/aurora-waybar.pid 2>/dev/null
fi
cat "$OUT"; echo; echo ">>> Bericht gespeichert: $OUT"
