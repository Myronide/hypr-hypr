#!/usr/bin/env python3
# Draconyx: Bildschirme.   dx-monitors show     erkannte Bildschirme anzeigen
#                          dx-monitors init     monitors_local.lua aus dem laufenden Zustand anlegen, falls es sie noch nicht gibt
import sys
from pathlib import Path
for d in (Path.home() / ".config/hypr/aurora", Path(__file__).resolve().parent.parent):
    if (d / "monitors.py").exists():
        sys.path.insert(0, str(d)); break
import monitors as M

cmd = sys.argv[1] if len(sys.argv) > 1 else "show"
if cmd == "show":
    for i, m in enumerate(M.live(), 1):
        print("%d. %-10s %dx%d@%.2f  Position %d,%d  Skalierung %g  Drehung %d  %s%s" % (i, m["name"], m["w"], m["h"], m["hz"], m["x"], m["y"], m["scale"], m["transform"] * 90, "AUS " if m["disabled"] else "", m["desc"]))
elif cmd == "init":
    n = M.init_config()
    print("monitors_local.lua angelegt (%d Bildschirme)" % n if n else "monitors_local.lua vorhanden oder keine Bildschirme erkannt – nichts geändert")
else:
    print(__doc__); sys.exit(2)
