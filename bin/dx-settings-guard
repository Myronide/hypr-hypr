#!/usr/bin/env python3
"""Draconyx: schützt die Shell-Einstellungen (~/.local/state/draconyx/settings.json: Taskleiste, angeheftete Apps, Desktop-Symbole …)
vor Zurücksetzen. Eine Aktualisierung darf diese Werte nie ändern.
  dx-settings-guard snapshot [DATEI]   aktuellen Stand sichern (Standard: ~/.local/share/draconyx-backups/settings-vor-update.json)
  dx-settings-guard restore  [DATEI]   Werte aus der Sicherung zurückschreiben: jeder Schlüssel der Sicherung gewinnt, neue Schlüssel
                                       der neuen Version bleiben. Gibt die zurückgesetzten Schlüssel aus.
  dx-settings-guard check    [DATEI]   nur zeigen, was abweicht"""
import json, os, shutil, sys, time
from pathlib import Path

CUR = Path.home() / ".local/state/draconyx/settings.json"
DEF = Path.home() / ".local/share/draconyx-backups/settings-vor-update.json"


def load(p):
    return json.loads(Path(p).read_text())


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "check"
    src = Path(a[1]) if len(a) > 1 else DEF
    if cmd == "snapshot":
        if not CUR.exists():
            return
        try:
            load(CUR)
        except ValueError:
            print("settings.json ist beschädigt – keine Sicherung überschrieben", file=sys.stderr); return
        src.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(CUR, src)
        print("gesichert:", src)
        return
    if cmd in ("restore", "check"):
        try:
            snap, cur = load(src), load(CUR)
        except (OSError, ValueError) as e:
            print("Keine brauchbare Sicherung/Einstellung:", e, file=sys.stderr); sys.exit(1)
        diff = [k for k, v in snap.items() if cur.get(k) != v]
        if cmd == "check":
            print("\n".join(diff) or "keine Abweichung"); return
        if not diff:
            print("nichts zurückzusetzen"); return
        shutil.copy2(CUR, str(CUR) + ".vor-restore-" + time.strftime("%Y%m%d-%H%M%S"))
        for k in diff:
            cur[k] = snap[k]
        tmp = CUR.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(cur, indent=4, ensure_ascii=False))
        os.replace(tmp, CUR)                       # atomar ersetzen
        print("zurückgesetzt auf deine Werte:", ", ".join(diff))
        return
    print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
