#!/usr/bin/env python3
"""Hypr Hypr Snip: schneidet einen Bereich aus einem Bildschirmfoto aus und kopiert/speichert ihn.
  dx-snip-crop BILD X Y B H copy|save|both     (Pixel des Bildes)
  dx-snip-crop BILD X Y B H edit               (Ausschnitt als Datei für den Editor: gibt den Pfad aus)
  dx-snip-crop BILD X Y B H ocr                (Text im Ausschnitt erkennen und kopieren; tesseract + Sprachpakete deu/eng)
  dx-snip-crop --screen MONITOR copy|save|both  (ganzer Monitor direkt)
  dx-snip-crop --deliver DATEI copy|save|both   (fertiges Bild aus dem Editor kopieren/speichern)"""
import datetime, os, shutil, subprocess, sys, tempfile
from pathlib import Path
try:
    from PIL import Image
except ImportError:
    sys.exit("dx-snip-crop: python-pillow fehlt (sudo pacman -S python-pillow)")


def rundir():
    """Privater Ordner für Zwischendateien: der Laufzeitordner des Nutzers (0700), sonst ein neuer privater Ordner – nie ein vorhersagbarer Name in /tmp."""
    rt = os.environ.get("XDG_RUNTIME_DIR")
    if rt and os.path.isdir(rt):
        return Path(rt)
    return Path(tempfile.mkdtemp(prefix="draconyx-snip-"))


def tell(*args):
    try:
        return subprocess.Popen(["notify-send", "-a", "Hypr Hypr", *args], stderr=subprocess.DEVNULL)
    except OSError:
        return None                                       # ohne notify-send trotzdem weiterarbeiten

def pictures():
    try:
        p = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True).stdout.strip()
    except OSError:
        p = ""
    return Path(p or Path.home() / "Bilder") / "Screenshots"

def deliver(img, mode):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    path = None
    if mode in ("save", "both"):
        d = pictures(); d.mkdir(parents=True, exist_ok=True)
        path = d / ("Screenshot_%s.png" % stamp)
        img.save(path)
    if mode in ("copy", "both"):
        tmp = rundir() / "draconyx-snip-out.png"
        img.save(tmp)
        try:
            with open(tmp, "rb") as f:
                subprocess.run(["wl-copy", "-t", "image/png"], stdin=f, timeout=15)
        except (OSError, subprocess.SubprocessError):
            tell("-u", "critical", "Screenshot", "Kopieren nicht möglich (wl-clipboard installiert?)")
        finally:
            tmp.unlink(missing_ok=True)                   # das Bild bleibt sonst unnötig liegen
    text = {"copy": "In die Zwischenablage kopiert", "save": "Gespeichert", "both": "Kopiert und gespeichert"}[mode]
    args = ["-t", "3500", "Screenshot", text + (("\n" + str(path)) if path else "")]
    if path: args[0:0] = ["-i", str(path)]
    tell(*args)

def ocr(img):
    """Text im Bild erkennen (tesseract) und in die Zwischenablage legen."""
    notify = lambda body: tell("-t", "4000", "Text erkennen", body)
    if not shutil.which("tesseract"):
        notify("tesseract ist nicht installiert."); return
    have = subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True).stdout.split()
    langs = [l for l in ("deu", "eng") if l in have] or [l for l in have if l not in ("osd",) and len(l) == 3][:1]
    if not langs:
        notify("Keine Sprachdaten für tesseract (Paket tesseract-data-deu / tesseract-data-eng)."); return
    tmp = rundir() / "draconyx-snip-ocr.png"
    big = img.convert("L")
    if big.height < 900: big = big.resize((big.width * 2, big.height * 2), Image.LANCZOS)   # kleine Schrift wird so besser erkannt
    big.save(tmp)
    r = subprocess.run(["tesseract", str(tmp), "stdout", "-l", "+".join(langs), "--psm", "6"], capture_output=True, text=True)
    tmp.unlink(missing_ok=True)
    text = r.stdout.strip()
    if not text:
        notify("Kein Text erkannt."); return
    subprocess.run(["wl-copy"], input=text, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    short = " ".join(text.split())
    notify("In die Zwischenablage kopiert:\n" + (short[:90] + "…" if len(short) > 90 else short))

def main(a):
    if a and a[0] == "--deliver":
        deliver(Image.open(a[1]).convert("RGBA"), a[2] if len(a) > 2 else "both")
        return
    if a and a[0] == "--screen":
        out = rundir() / "draconyx-snip-screen.png"
        try:
            subprocess.run(["grim", "-o", a[1], str(out)], check=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            tell("-u", "critical", "Screenshot", "Bildschirmfoto fehlgeschlagen (grim installiert? Läuft Wayland?)"); sys.exit(1)
        deliver(Image.open(out).convert("RGBA"), a[2] if len(a) > 2 else "both")
        out.unlink(missing_ok=True)
        return
    try:
        src, x, y, w, h, mode = a[0], *map(int, a[1:5]), a[5]
        if mode not in ("copy", "save", "both", "edit", "ocr"): raise ValueError(mode)
        img = Image.open(src)
    except (IndexError, ValueError, OSError) as e:
        sys.exit("dx-snip-crop: ungültiger Aufruf oder Bild nicht lesbar (%s)\n%s" % (e, __doc__))
    x = max(0, min(x, img.width - 1)); y = max(0, min(y, img.height - 1))
    w = max(1, min(w, img.width - x)); h = max(1, min(h, img.height - y))
    cropped = img.crop((x, y, x + w, y + h))
    if mode == "edit":
        out = rundir() / "draconyx-snip-edit.png"
        cropped.save(out)
        print(out)
        return
    if mode == "ocr":
        ocr(cropped); return
    deliver(cropped, mode)

main(sys.argv[1:])
