#!/usr/bin/env bash
# Hypr Hypr/Aurora: startet das gewählte Terminal.  dx-terminal [--dir ORDNER] [--class KLASSE] [-- BEFEHL ...]
# Auswahl: $DX_TERMINAL, sonst ~/.config/draconyx/terminal (eine Zeile), sonst Aurora-Einstellung, sonst erstes installiertes.
dir=""; cls=""; cmd=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) [ $# -ge 2 ] || { echo "dx-terminal: --dir braucht einen Ordner" >&2; exit 2; }; dir="$2"; shift 2;;
    --class) [ $# -ge 2 ] || { echo "dx-terminal: --class braucht einen Namen" >&2; exit 2; }; cls="$2"; shift 2;;
    --) shift; cmd=("$@"); break;;
    *) cmd=("$@"); break;;
  esac
done
term="${DX_TERMINAL:-}"
[ -z "$term" ] && [ -f "$HOME/.config/draconyx/terminal" ] && term="$(head -1 "$HOME/.config/draconyx/terminal" | tr -d '[:space:]')"
if [ -z "$term" ] && [ -f "$HOME/.config/hypr/aurora/preferences.json" ]; then
  term="$(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1])).get("terminal",""))' "$HOME/.config/hypr/aurora/preferences.json" 2>/dev/null)"
fi
if [ -z "$term" ] || ! command -v "$term" >/dev/null 2>&1; then
  for t in ghostty kitty foot alacritty wezterm konsole gnome-terminal xfce4-terminal tilix xterm; do command -v "$t" >/dev/null 2>&1 && term="$t" && break; done
fi
if [ -n "$dir" ] && ! cd "$dir" 2>/dev/null; then dir=""; fi          # Ordner existiert nicht (mehr): im Heimordner öffnen
case "$term" in
  ghostty)   exec ghostty ${cls:+--class="$cls"} ${dir:+--working-directory="$dir"} ${cmd[@]:+-e "${cmd[@]}"};;
  kitty)     exec kitty ${cls:+--class "$cls"} ${dir:+--directory "$dir"} "${cmd[@]}";;
  foot)      exec foot ${cls:+--app-id "$cls"} ${dir:+-D "$dir"} "${cmd[@]}";;
  alacritty) exec alacritty ${cls:+--class "$cls"} ${dir:+--working-directory "$dir"} ${cmd[@]:+-e "${cmd[@]}"};;
  wezterm)   exec wezterm start ${dir:+--cwd "$dir"} ${cmd[@]:+-- "${cmd[@]}"};;
  konsole)   exec konsole ${dir:+--workdir "$dir"} ${cmd[@]:+-e "${cmd[@]}"};;
  gnome-terminal) exec gnome-terminal ${dir:+--working-directory="$dir"} ${cmd[@]:+-- "${cmd[@]}"};;
  xfce4-terminal) exec xfce4-terminal ${dir:+--working-directory="$dir"} ${cmd[@]:+-x "${cmd[@]}"};;
  tilix)     exec tilix ${dir:+--working-directory="$dir"} ${cmd[@]:+-e "$(printf '%q ' "${cmd[@]}")"};;
  xterm)     exec xterm ${cmd[@]:+-e "${cmd[@]}"};;
  *) echo "Kein Terminal gefunden – installiere z. B. Ghostty:  sudo pacman -S ghostty" >&2; exit 127;;
esac
