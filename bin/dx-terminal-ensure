#!/usr/bin/env bash
# Draconyx: sorgt dafür, dass IMMER mindestens ein Terminal installiert ist. Du kannst Ghostty, Kitty & Co. frei deinstallieren –
# solange ein anderes Terminal da ist, passiert nichts. Fehlt das letzte, wird Ghostty installiert (Passwort per Dialog).
# Außerdem: zeigt die Einstellung auf ein nicht (mehr) installiertes Terminal, wird sie auf ein vorhandenes umgestellt.
#   dx-terminal-ensure [--quiet]
TERMS=(ghostty kitty foot alacritty wezterm konsole gnome-terminal xfce4-terminal tilix xterm)
CFG="$HOME/.config/draconyx/terminal"
first=""; for t in "${TERMS[@]}"; do command -v "$t" >/dev/null 2>&1 && { first="$t"; break; }; done
if [ -n "$first" ]; then
  cur="$(head -1 "$CFG" 2>/dev/null | tr -d '[:space:]')"
  if [ -z "$cur" ] || ! command -v "$cur" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$CFG")"; echo "$first" > "$CFG"
    [ "$1" = "--quiet" ] || echo "Terminal-Einstellung auf $first gesetzt (vorher: ${cur:-leer})"
  fi
  exit 0
fi
# kein Terminal da: höchstens einmal pro Stunde versuchen (kein Dialog-Dauerfeuer)
STAMP="${XDG_RUNTIME_DIR:-/tmp}/draconyx-terminal-ensure"
now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
[ $((now - last)) -lt 3600 ] && exit 0
echo "$now" > "$STAMP"
notify-send -a Draconyx -i utilities-terminal "Kein Terminal installiert" "Ghostty wird installiert – gleich fragt ein Fenster nach deinem sudo-Passwort." 2>/dev/null
export SUDO_ASKPASS="$HOME/.local/bin/dx-askpass"
if sudo -A pacman -S --needed --noconfirm ghostty; then
  echo ghostty > "$CFG"
  notify-send -a Draconyx -i utilities-terminal "Ghostty installiert" "Es war kein Terminal mehr vorhanden." 2>/dev/null
else
  notify-send -a Draconyx -u critical -i utilities-terminal "Terminal konnte nicht installiert werden" "Bitte von Hand:  sudo pacman -S ghostty" 2>/dev/null
  exit 1
fi
