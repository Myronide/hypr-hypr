#!/usr/bin/env python3
# Hypr Hypr: verschiebt ein Fenster mit dem Mauszeiger (für die Titelleisten der Shell). dx-window-drag 0x<adresse>
# Läuft, bis die Shell den Prozess beendet (Maustaste losgelassen). Gibt bei jeder Bewegung "x y" (neue Fensterposition) aus.
#  * Ein maximiertes Fenster wird dabei erst auf seine alte Größe zurückgesetzt (Zeiger bleibt im gleichen Verhältnis auf der Leiste).
#  * Zieht man auf einen anderen Bildschirm, wird das Fenster diesem Bildschirm zugeordnet (sonst maximiert das Andocken danach
#    wieder auf dem alten).
#  * Das Andocken (dx_snap) sperrt weitere Bewegungen beim Loslassen direkt im Compositor.
import json, os, re, signal, socket, sys, time

ADDR = re.compile(r"^0x[0-9a-fA-F]{1,16}$")

def call(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(1.0)
    s.connect("%s/hypr/%s/.socket.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"]))
    s.sendall(cmd.encode())
    out = b""
    while True:
        d = s.recv(4096)
        if not d:
            break
        out += d
    s.close()
    return out.decode()

def window(addr):
    return next((c for c in json.loads(call("j/clients")) if c["address"] == addr), None)

def cursor():
    c = json.loads(call("j/cursorpos"))
    return int(c["x"]), int(c["y"])

def monitor_at(mons, x, y):
    for m in mons:
        width, height = m["width"], m["height"]
        if m.get("transform", 0) % 2:
            width, height = height, width
        scale = m.get("scale", 1) or 1
        if m["x"] <= x < m["x"] + width / scale and m["y"] <= y < m["y"] + height / scale:
            return m
    return None

MOUSEUP = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "draconyx-mouse-up")

def mouse_up_since(t0_ns):
    """Loslassen seit Beginn des Klicks, auch während Prozessstart und IPC."""
    try:
        return os.stat(MOUSEUP).st_mtime_ns >= t0_ns
    except OSError:
        return False

def drag(addr, alive, report=None, start=None, started_ns=None):
    """Ein Griffpunkt und eine Release-Grenze für die gesamte Geste."""
    if not ADDR.match(str(addr)):
        return                                  # die Adresse landet im Lua-Text von "eval": nur echte Hex-Adressen zulassen (keine Code-Einschleusung)
    t0 = time.time_ns() if started_ns is None else started_ns
    end = time.monotonic() + 120
    def held():
        return time.monotonic() < end and alive() and not mouse_up_since(t0)

    if not held():
        return
    win = window(addr)
    if not win or not win.get("floating") or win.get("fullscreen"):
        return
    cx, cy = start if start is not None else cursor()
    # Ein Klick/Doppelklick darf ein maximiertes Fenster noch nicht wiederherstellen.
    while held():
        px, py = cursor()
        if abs(px - cx) + abs(py - cy) >= 6:
            break
        time.sleep(0.008)
    else:
        return
    if not held():
        return
    token = "%d-%d" % (os.getpid(), t0)
    try:
        call("eval DXSnap.beginDrag('%s', '%s', %d, %d)" % (addr, token, cx, cy))
        win = window(addr)
        if not win or not held():
            return
        ox, oy = cx - win["at"][0], cy - win["at"][1]
        mons, mons_at, cur_mon, last = [], float("-inf"), win.get("monitor"), None
        while held():
            cx, cy = cursor()
            pos = (cx - ox, cy - oy)
            if pos != last:
                if time.monotonic() - mons_at > 0.4:
                    mons, mons_at = json.loads(call("j/monitors")), time.monotonic()
                m = monitor_at(mons, cx, cy)
                mon = m["name"] if m is not None and m["id"] != cur_mon else None
                if not held():
                    break
                # Release und Bewegung laufen im Compositor nacheinander: ein bereits
                # unterwegs befindlicher IPC-Aufruf darf nach Release nicht mehr bewegen.
                call("eval DXSnap.moveDrag('%s', '%s', %d, %d, %s)" %
                     (addr, token, pos[0], pos[1], json.dumps(mon) if mon else "nil"))
                if m is not None:
                    cur_mon = m["id"]
                last = pos
                if report:
                    report(pos)
            time.sleep(0.008)
    finally:
        try:
            call("eval DXSnap.endDrag('%s', '%s')" % (addr, token))
        except OSError:
            pass                            # Fenster/Sitzung kann inzwischen beendet sein

if __name__ == "__main__":
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, int(signal.SIGTERM))       # stirbt mit der Shell
    except OSError:
        pass
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    a = sys.argv[1] if len(sys.argv) > 1 else ""
    if not os.environ.get("XDG_RUNTIME_DIR") or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        sys.exit("dx-window-drag: keine Hyprland-Sitzung (HYPRLAND_INSTANCE_SIGNATURE fehlt)")
    start = (int(float(sys.argv[2])), int(float(sys.argv[3]))) if len(sys.argv) > 3 else None
    started_ns = int(sys.argv[4]) * 1_000_000 if len(sys.argv) > 4 else None
    drag(a if a.startswith("0x") else "0x" + a, lambda: True,
         lambda p: print(p[0], p[1], flush=True), start, started_ns)
