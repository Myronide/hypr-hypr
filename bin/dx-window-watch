#!/usr/bin/env python3
# Draconyx: meldet der Shell die Fenster und Bildschirme von Hyprland – jede Änderung als eine JSON-Zeile {"c": [...], "m": [...]}.
# Sparsam: im Ruhezustand wird nur etwa 5 Mal pro Sekunde geprüft (bei Vollbild/Spielen 2 Mal), und sobald sich etwas bewegt
# (oder ein Hyprland-Ereignis kommt) kurz mit ~100 Prüfungen pro Sekunde, damit die Titelleisten der Shell fest am Fenster
# kleben. Läuft nur, solange die Shell es braucht (stirbt mit ihr).
import json, os, signal, socket, sys, time

def call(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(1.0)
    s.connect("%s/hypr/%s/.socket.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"]))
    s.sendall(cmd.encode())
    out = b""
    while True:
        d = s.recv(65536)
        if not d:
            break
        out += d
    s.close()
    return out.decode()

try:
    import ctypes
    ctypes.CDLL("libc.so.6").prctl(1, int(signal.SIGTERM))       # PR_SET_PDEATHSIG
except OSError:
    pass
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

KEEP = ("address", "class", "title", "at", "size", "floating", "fullscreen", "workspace", "monitor", "pid", "mapped", "hidden", "focusHistoryID")

# Hyprland-Ereignisse (neues/geschlossenes Fenster, Fokus, Desktop …) wecken den schnellen Takt sofort
ev = socket.socket(socket.AF_UNIX)
ev.connect("%s/hypr/%s/.socket2.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"]))
ev.setblocking(False)

last, n, cache, fast_until = "", 0, [], 0.0
while True:
    now = time.time()
    try:
        while True:                                   # Ereignisse leeren
            if not ev.recv(65536):
                sys.exit(0)
            fast_until = now + 0.6
    except BlockingIOError:
        pass
    try:
        cl = [{k: c.get(k) for k in KEEP} for c in json.loads(call("j/clients"))]
        busy = False
        for c in cl:
            ws = c.get("workspace") or {}
            c["workspace"] = {"id": ws.get("id"), "name": ws.get("name")}
            if c.get("fullscreen") in (2, 3):
                busy = True                           # Vollbild/Spiel: so wenig Last wie möglich
        if n % 10 == 0 or not last:                   # Bildschirme ändern sich selten
            cache = [{"id": m["id"], "name": m["name"], "x": m["x"], "y": m["y"], "ws": (m.get("activeWorkspace") or {}).get("id"),
                      "top": (m.get("reserved") or [0, 0, 0, 0])[1]} for m in json.loads(call("j/monitors"))]
        line = json.dumps({"c": cl, "m": cache}, separators=(",", ":"))
        if line != last:
            print(line, flush=True)
            last = line
            fast_until = now + 0.6                    # es bewegt sich etwas: weiter im schnellen Takt
    except (OSError, ValueError):
        time.sleep(0.5)
    n += 1
    time.sleep(0.5 if busy and now > fast_until else (0.01 if now < fast_until else 0.2))
