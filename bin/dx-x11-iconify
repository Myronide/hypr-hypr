#!/usr/bin/env python3
# Draconyx: Wächter für XWayland-Apps (z. B. Steam, Brave, VS Code, Discord, Aurora). Hyprland ignoriert zwei Anfragen dieser Apps:
#  * WM_CHANGE_STATE (Minimieren): der Wächter gibt pro Ereignis eine Zeile "iconify 0x<hyprland-adresse>" aus.
#  * _NET_WM_MOVERESIZE (Ziehen an der eigenen Titelleiste): der Wächter verschiebt das Fenster selbst, solange die linke Maustaste
#    gehalten wird (ohne Alt/Strg+Alt). Das Andocken (dx_snap) bemerkt die Bewegung wie bei jedem anderen Ziehen.
# Beides liest er mit (SubstructureNotify auf dem Root-Fenster).
import ctypes, ctypes.util, json, socket, subprocess, sys

# Nur eine Instanz: ein neuer Wächter übernimmt und beendet den alten (sonst melden mehrere Wächter jedes Ereignis mehrfach,
# und Minimieren/Wiederherstellen schaukelt sich auf). Stirbt die Shell, stirbt auch der Wächter (PDEATHSIG).
import os as _os, signal as _signal, ctypes as _ct
def _single_instance(name):
    pidf = _os.path.join(_os.environ.get("XDG_RUNTIME_DIR", "/tmp"), name + ".pid")
    try:
        old = int(open(pidf).read().strip())
    except (OSError, ValueError):
        old = 0
    if old and old != _os.getpid():
        try:
            if name.encode() in open("/proc/%d/cmdline" % old, "rb").read():
                _os.kill(old, _signal.SIGTERM)
        except OSError:
            pass
    try:
        open(pidf, "w").write(str(_os.getpid()))
    except OSError:
        pass
    try:
        _ct.CDLL("libc.so.6").prctl(1, int(_signal.SIGTERM))      # PR_SET_PDEATHSIG
    except OSError:
        pass
_single_instance("dx-x11-iconify")

x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")

class ClientMsg(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("message_type", ctypes.c_ulong),
                ("format", ctypes.c_int), ("l", ctypes.c_long * 5)]

class Event(ctypes.Union):
    _fields_ = [("type", ctypes.c_int), ("xclient", ClientMsg), ("pad", ctypes.c_long * 24)]

x.XOpenDisplay.restype = ctypes.c_void_p
x.XOpenDisplay.argtypes = [ctypes.c_char_p]
x.XDefaultRootWindow.restype = ctypes.c_ulong
x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
x.XInternAtom.restype = ctypes.c_ulong
x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.POINTER(Event)]
x.XGetAtomName.restype = ctypes.c_char_p
x.XGetAtomName.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
x.XQueryPointer.restype = ctypes.c_int
x.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
                            ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
                            ctypes.POINTER(ctypes.c_uint)]
import os, time
LOG = os.path.expanduser("~/.local/state/draconyx/x11-events.log")
IGNORE = {b"_NET_WM_USER_TIME", b"WM_PROTOCOLS"}

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()

def hypr_address(xid):
    pid = run(["xdotool", "getwindowpid", str(xid)])
    title = run(["xdotool", "getwindowname", str(xid)])
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"]))
    except Exception:
        return None
    cand = [c for c in clients if c.get("xwayland") and str(c.get("pid")) == pid]
    for c in cand:
        if c.get("title") == title:
            return c["address"]
    return cand[0]["address"] if cand else None

def pointer(dpy, root):
    """(x, y, linke Taste gedrückt) im Root-Koordinatensystem (= Hyprland-Layout bei einem Skalierungsfaktor von 1)"""
    r, c = ctypes.c_ulong(), ctypes.c_ulong()
    rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
    m = ctypes.c_uint()
    x.XQueryPointer(dpy, root, ctypes.byref(r), ctypes.byref(c), ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(m))
    return rx.value, ry.value, bool(m.value & 0x100)

def client_for(xid):
    pid = run(["xdotool", "getwindowpid", str(xid)])
    title = run(["xdotool", "getwindowname", str(xid)])
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"]))
    except Exception:
        return None
    cand = [c for c in clients if c.get("xwayland") and str(c.get("pid")) == pid]
    for c in cand:
        if c.get("title") == title:
            return c
    return cand[0] if cand else None

def hypr_call(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(1.0)
    s.connect("%s/hypr/%s/.socket.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"]))
    s.sendall(cmd.encode())
    out = b""
    while True:
        d = s.recv(4096)
        if not d:
            break
        out += d
    s.close()
    return out.decode()

call = hypr_call
# Verschieben (gleiche Logik wie bin/dx-window-drag): maximiert -> alte Größe, Bildschirmwechsel, Andocken nicht überschreiben
def window(addr):
    return next((c for c in json.loads(call("j/clients")) if c["address"] == addr), None)

def cursor():
    c = json.loads(call("j/cursorpos"))
    return int(c["x"]), int(c["y"])

def monitor_at(mons, x, y):
    for m in mons:
        if m["x"] <= x < m["x"] + m["width"] and m["y"] <= y < m["y"] + m["height"]:
            return m
    return None

def drag(addr, alive, report=None):
    """Fenster mit dem Zeiger mitnehmen, solange alive() wahr ist (höchstens 120 s)."""
    win = window(addr)
    if not win or not win.get("floating") or win.get("fullscreen"):
        return
    cx, cy = cursor()
    call("eval DXSnap.restoreForDrag('%s', %d, %d)" % (addr, cx, cy))        # maximiert? -> alte Größe
    time.sleep(0.03)
    win = window(addr) or win
    ox, oy = cx - win["at"][0], cy - win["at"][1]
    mons, mons_at, cur_mon = [], 0.0, win.get("monitor")
    last, end, n = None, time.time() + 120, 0
    # Ohne Fensteranimation ziehen: sonst läuft das Fenster dem Zeiger hinterher (jede Bewegung würde animiert)
    call('dispatch hl.dsp.window.set_prop({ window = "address:%s", prop = "no_anim", value = "1" })' % addr)
    try:
        _loop(addr, alive, report, ox, oy, mons, mons_at, cur_mon, last, end, n)
    finally:
        call('dispatch hl.dsp.window.set_prop({ window = "address:%s", prop = "no_anim", value = "0" })' % addr)

MOUSEUP = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "draconyx-mouse-up")

def mouse_up_since(t0_ns):
    """Hat die Hyprland-Konfiguration (dx_snap) seit t0 ein Loslassen der Maustaste gemeldet?"""
    try:
        return os.stat(MOUSEUP).st_mtime_ns > t0_ns
    except OSError:
        return False

def _loop(addr, alive, report, ox, oy, mons, mons_at, cur_mon, last, end, n):
    t0 = time.time_ns() - 20_000_000
    while time.time() < end and alive() and not mouse_up_since(t0):
        cx, cy = cursor()
        pos = (cx - ox, cy - oy)
        if pos != last:
            n += 1
            if last is not None and n % 3 == 0:       # hat jemand anderes das Fenster bewegt (Andocken beim Loslassen)? Dann nicht dagegen arbeiten
                a = json.loads(call("j/activewindow"))
                if a.get("address") == addr and (abs(a["at"][0] - last[0]) > 3 or abs(a["at"][1] - last[1]) > 3):
                    break
            if time.time() - mons_at > 0.4:
                mons, mons_at = json.loads(call("j/monitors")), time.time()
            m = monitor_at(mons, cx, cy)
            if m is not None and m["id"] != cur_mon:  # Zeiger auf einem anderen Bildschirm: Fenster diesem zuordnen
                call('dispatch hl.dsp.window.move({ window = "address:%s", monitor = "%s", follow = false })' % (addr, m["name"]))
                cur_mon = m["id"]
                last = None                           # unsere eigene Verschiebung nicht als fremde Bewegung deuten
            if not alive() or mouse_up_since(t0):
                break
            call('dispatch hl.dsp.window.move({ window = "address:%s", x = %d, y = %d, relative = false })' % (addr, pos[0], pos[1]))
            last = pos
            if report:
                report(pos)
        time.sleep(0.008)


def drag_window(dpy, root, xid):
    """Fenster einer X11-App mit dem Zeiger mitnehmen, solange die linke Taste gehalten wird."""
    c = client_for(xid)
    if not c:
        return
    state = {"n": 0, "down": True}
    def alive():
        state["n"] += 1
        state["down"] = pointer(dpy, root)[2]       # Taste ist los: sofort aufhören (das Andocken beim Loslassen darf nicht überschrieben werden)
        return state["down"]
    drag(c["address"], alive)

dpy = x.XOpenDisplay(None)
if not dpy:
    sys.exit("kein X-Display (DISPLAY gesetzt?)")
root = x.XDefaultRootWindow(dpy)
x.XSelectInput(dpy, root, 1 << 19)                       # SubstructureNotifyMask
change_state = x.XInternAtom(dpy, b"WM_CHANGE_STATE", 0)
moveresize = x.XInternAtom(dpy, b"_NET_WM_MOVERESIZE", 0)
ev = Event()
try:
    if os.path.getsize(LOG) > 200_000:       # Log klein halten
        open(LOG, "w").close()
except OSError:
    pass
logf = open(LOG, "a", buffering=1)
while True:
    x.XNextEvent(dpy, ctypes.byref(ev))
    if ev.type == 33:                                    # alle Client-Nachrichten protokollieren (Fehlersuche)
        name = x.XGetAtomName(dpy, ev.xclient.message_type)
        if name not in IGNORE:
            extra = ""
            if name == b"_NET_WM_STATE":
                names = []
                for v in (ev.xclient.l[1], ev.xclient.l[2]):
                    if v:
                        n = x.XGetAtomName(dpy, v)
                        names.append(n.decode(errors="replace") if n else hex(v))
                extra = " [" + ("add" if ev.xclient.l[0] == 1 else "remove" if ev.xclient.l[0] == 0 else "toggle") + " " + ", ".join(names) + "]"
            logf.write("%s win=%#x %s%s l=%s\n" % (time.strftime("%H:%M:%S"), ev.xclient.window, name.decode(errors="replace"), extra,
                       [hex(v) for v in ev.xclient.l]))
    if ev.type == 33 and ev.xclient.message_type == change_state and ev.xclient.l[0] == 3:   # IconicState
        addr = hypr_address(ev.xclient.window)
        if addr:
            try:
                hypr_call("eval DXSnap.noteMinimize('%s')" % addr)      # sofort: die Meldung "maximiert" der App beim Minimieren nicht ausführen
            except OSError:
                pass
            print("iconify", addr, flush=True)
    if ev.type == 33 and ev.xclient.message_type == moveresize and ev.xclient.l[2] == 8:     # _NET_WM_MOVERESIZE_MOVE
        try:
            drag_window(dpy, root, ev.xclient.window)
        except Exception as e:
            logf.write("Fehler beim Verschieben: %r\n" % (e,))
