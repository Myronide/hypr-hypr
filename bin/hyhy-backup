#!/usr/bin/env python3
"""Hypr Hypr: Einstellungen sichern und wiederherstellen (ein Archiv mit allem, was zu deinem Setup gehört).
  hyhy-backup create [NAME]        Sicherung anlegen (Standard-Ordner: ~/Documents/Draconyx-Backups)
  hyhy-backup list [--json]        vorhandene Sicherungen
  hyhy-backup restore DATEI        wiederherstellen (vorher wird der jetzige Stand automatisch gesichert)
  hyhy-backup auto                 höchstens einmal pro Woche automatisch sichern, die letzten 10 behalten
  hyhy-backup delete DATEI         eine Sicherung löschen
Enthalten: Shell-Einstellungen (Taskleiste, angeheftete Apps, Desktop-Symbole …), Farben/Schrift/Terminal/Tastaturbelegung/Tastenkombinationen,
Aurora-Einstellungen, Monitore, Fenster-Regeln, Autostart, Hyprland-Konfiguration. Keine Programme, keine Wallpaper-Dateien."""
import io, json, os, re, subprocess, sys, tarfile, time
from pathlib import Path

HOME = Path.home()
DIR = HOME / "Documents/Draconyx-Backups"
INCLUDE = [
    ".config/hypr-hypr", ".local/state/hypr-hypr/settings.json", ".local/share/draconyx-apps/installed.json",
    ".config/hypr/hyprland.lua", ".config/hypr/monitors_local.lua", ".config/hypr/csd-apps", ".config/hypr/hypridle.conf",
    ".config/hypr/hyprlock.conf", ".config/hypr/aurora/preferences.json", ".config/hypr/aurora/preferences.lua",
    ".config/hypr/aurora/pins.json", ".config/autostart", ".config/gtk-3.0/settings.ini", ".config/gtk-4.0/settings.ini",
]
# Alte Sicherungen (vor hypr-hypr) enthalten die alten Pfade: beim Wiederherstellen werden die weiterhin angenommen.
LEGACY = [".config/draconyx", ".local/state/draconyx/settings.json"]
EXCLUDE_SUFFIX = (".tmp", ".lock", ".pid")


def version():
    try:
        for p in (HOME / ".config/hypr-hypr/install.json", HOME / ".config/draconyx/install.json"):
            if p.exists():
                return json.loads(p.read_text()).get("version", "?")
        return "?"
    except (OSError, ValueError):
        return "?"


def create(name=""):
    DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", name).strip("._")[:40]       # nur harmlose Zeichen im Dateinamen
    out = DIR / ("hypr-hypr-%s%s.tar.gz" % (stamp, ("-" + name) if name else ""))
    n = 1
    while out.exists():                                                  # zwei Sicherungen in derselben Sekunde überschreiben sich nicht
        out = DIR / ("hypr-hypr-%s%s-%d.tar.gz" % (stamp, ("-" + name) if name else "", n)); n += 1
    part = out.with_name(out.name + ".part")                             # erst fertig schreiben, dann umbenennen: nie ein halbes Archiv
    manifest = {"version": version(), "created": int(time.time()), "host": os.uname().nodename, "files": []}
    try:
        _write_archive(part, manifest)
        os.chmod(part, 0o600)                                            # enthält deine Einstellungen: nur für dich lesbar
        os.replace(part, out)
    finally:
        part.unlink(missing_ok=True)
    return out


def _write_archive(out, manifest):
    with tarfile.open(out, "w:gz") as tar:
        for rel in INCLUDE:
            p = HOME / rel
            if not p.exists():
                continue
            if p.is_dir():
                for f in sorted(p.rglob("*")):
                    if f.is_file() and not f.name.endswith(EXCLUDE_SUFFIX) and not f.is_symlink():
                        tar.add(f, arcname=str(f.relative_to(HOME))); manifest["files"].append(str(f.relative_to(HOME)))
            else:
                tar.add(p, arcname=rel); manifest["files"].append(rel)
        data = json.dumps(manifest, indent=2, ensure_ascii=False).encode()
        info = tarfile.TarInfo("backup.json"); info.size = len(data); info.mtime = int(time.time())
        tar.addfile(info, io.BytesIO(data))


def info(path):
    try:
        with tarfile.open(path) as tar:
            f = tar.extractfile("backup.json")
            m = json.loads(f.read()) if f else {}
    except (OSError, tarfile.TarError, ValueError, KeyError):
        m = {}
    st = Path(path).stat()
    return {"path": str(path), "name": Path(path).name, "size": st.st_size, "mtime": int(st.st_mtime),
            "version": m.get("version", "?"), "files": len(m.get("files", []))}


def listing():
    if not DIR.exists():
        return []
    return [info(p) for p in sorted(DIR.glob("*.tar.gz"), key=lambda p: -p.stat().st_mtime)]


def safe_members(tar):
    for m in tar.getmembers():
        n = m.name
        if m.name == "backup.json":
            continue
        if n.startswith("/") or ".." in Path(n).parts or not (m.isfile() or m.isdir()) or m.issym() or m.islnk():
            continue
        if not any(n == r or n.startswith(r + "/") for r in INCLUDE + LEGACY):
            continue
        yield m


def restore(path):
    path = Path(path)
    if not path.is_file():
        print("Datei nicht gefunden:", path, file=sys.stderr); return 1
    # Erst prüfen, dass das Archiv lesbar ist, BEVOR der jetzige Stand angefasst wird
    try:
        with tarfile.open(path) as tar:
            members = list(safe_members(tar))
            if not members:
                print("Das Archiv enthält keine Hypr Hypr-Dateien – nichts wiederhergestellt.", file=sys.stderr); return 1
            for m in members:                                            # ganzes Archiv einmal durchlesen: ein beschädigtes bricht hier ab
                if m.isfile():
                    f = tar.extractfile(m)
                    while f and f.read(1 << 20):
                        pass
    except (tarfile.TarError, EOFError, OSError) as e:
        print("Die Sicherung ist beschädigt oder kein Archiv (%s) – nichts wiederhergestellt." % e, file=sys.stderr); return 1
    before = create("vor-wiederherstellung")
    print("Jetziger Stand gesichert:", before)
    with tarfile.open(path) as tar:
        members = list(safe_members(tar))
        try:
            tar.extractall(HOME, members=members, filter="data")        # "data": keine Sonderdateien/fremden Besitzer/Pfade nach außen
        except TypeError:                                                # ältere Python-Versionen kennen filter= nicht
            tar.extractall(HOME, members=members)
    print("%d Dateien wiederhergestellt" % len(members))
    try:
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass                                                             # ohne laufendes Hyprland erst beim nächsten Anmelden
    return 0


def auto():
    L = listing()
    autos = [x for x in L if "-auto" in x["name"]]
    if autos and time.time() - autos[0]["mtime"] < 7 * 86400:
        return
    create("auto")
    autos = [x for x in listing() if "-auto" in x["name"]]
    for x in autos[10:]:
        Path(x["path"]).unlink(missing_ok=True)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "list"
    if cmd == "create":
        print(create(a[1] if len(a) > 1 else ""))
    elif cmd == "list":
        L = listing()
        if "--json" in a:
            print(json.dumps(L, ensure_ascii=False))
        else:
            for x in L:
                print("%s  v%s  %d Dateien  %.1f KB" % (x["name"], x["version"], x["files"], x["size"] / 1024))
    elif cmd == "restore" and len(a) == 2:
        sys.exit(restore(a[1]))
    elif cmd == "auto":
        auto()
    elif cmd == "delete" and len(a) == 2:
        p = Path(a[1])
        if p.parent == DIR and p.name.endswith(".tar.gz"):
            p.unlink(missing_ok=True)
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
