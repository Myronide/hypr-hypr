#!/usr/bin/env bash
# Hypr Hypr: Electron-Apps (Discord & Co.) über XWayland starten. Hyprland ignoriert das Minimieren-Symbol nativer Wayland-Apps;
# bei XWayland-Fenstern fängt die Shell es ab (hyhy-x11-iconify). Es werden eigene Starter in ~/.local/share/applications angelegt,
# die den Start mit --ozone-platform=x11 erzwingen. Bestehende eigene Starter bleiben unangetastet.
#   hyhy-electron-x11          anlegen / erneuern
#   hyhy-electron-x11 --undo   unsere Starter wieder entfernen
USER_APPS="$HOME/.local/share/applications"; MARK="# Draconyx: Electron über XWayland"
IDS=(discord discord-ptb discord-canary vesktop webcord legcord armcord slack signal-desktop element-desktop teams-for-linux)
if [ "$1" = "--undo" ]; then
  for id in "${IDS[@]}"; do f="$USER_APPS/$id.desktop"; [ -f "$f" ] && grep -q "$MARK" "$f" && rm -f "$f" && echo "entfernt: $f"; done
  for f in "$HOME"/.config/*-flags.conf; do [ -f "$f" ] && grep -q "$MARK" "$f" && rm -f "$f" && echo "entfernt: $f"; done; exit 0
fi
n=0
for id in "${IDS[@]}"; do
  src=""; for d in /usr/share/applications /var/lib/flatpak/exports/share/applications; do [ -f "$d/$id.desktop" ] && { src="$d/$id.desktop"; break; }; done
  [ -n "$src" ] || continue
  dst="$USER_APPS/$id.desktop"
  [ -e "$dst" ] && ! grep -q "$MARK" "$dst" && continue          # eigener Starter des Nutzers: nicht anfassen
  mkdir -p "$USER_APPS"
  # nach dem Programm in jeder Exec-Zeile die Option einfügen (Flatpak-Starter ausgenommen)
  grep -q '^Exec=.*flatpak' "$src" && continue
  # Pfad mit Leerzeichen im Exec-Wert in Anführungszeichen setzen; "&" und "|" im Pfad für sed maskieren
  launch="$HOME/.local/bin/hyhy-launch"; case "$launch" in *" "*) launch="\"$launch\"";; esac
  launch_esc="$(printf '%s' "$launch" | sed -e 's/[&|\\]/\\&/g')"
  { echo "$MARK"; sed -E "s|^Exec=([^ ]+)|Exec=$launch_esc \\1 --ozone-platform=x11|" "$src"; } > "$dst.tmp"
  if [ -f "$dst" ] && cmp -s "$dst.tmp" "$dst"; then rm -f "$dst.tmp"; else mv "$dst.tmp" "$dst"; echo "angelegt: $dst"; n=$((n+1)); fi
done
# Chromium-Browser: dieselbe Option über die jeweilige Flags-Datei (nur anlegen, wenn es sie nicht gibt)
for pair in "code:code-flags.conf" "codium:codium-flags.conf" "code-oss:code-oss-flags.conf" "cursor:cursor-flags.conf" "windsurf:windsurf-flags.conf" "electron:electron-flags.conf" "chromium:chromium-flags.conf" "google-chrome-stable:chrome-flags.conf" "vivaldi-stable:vivaldi-flags.conf" "microsoft-edge-stable:microsoft-edge-stable-flags.conf" "opera:opera-flags.conf"; do
  bin="${pair%%:*}"; fl="$HOME/.config/${pair#*:}"
  command -v "$bin" >/dev/null 2>&1 || continue
  [ -e "$fl" ] && continue
  mkdir -p "$(dirname "$fl")"
  printf '%s\n%s\n' "$MARK" '--ozone-platform=x11' > "$fl" || { echo "konnte $fl nicht schreiben" >&2; continue; }
  echo "angelegt: $fl"; n=$((n+1))
done
command -v update-desktop-database >/dev/null && update-desktop-database "$USER_APPS" 2>/dev/null
[ "$n" -gt 0 ] && echo "Hinweis: laufende Apps einmal beenden und neu starten, damit sie über XWayland laufen."
exit 0
