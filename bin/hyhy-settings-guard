#!/usr/bin/env python3
"""Hypr Hypr: schützt die Shell-Einstellungen (~/.local/state/hypr-hypr/settings.json: Taskleiste, angeheftete Apps, Desktop-Symbole …)
vor Zurücksetzen. Eine Aktualisierung darf diese Werte nie ändern.
  hyhy-settings-guard snapshot [DATEI]   aktuellen Stand sichern (Standard: ~/.local/share/hypr-hypr-backups/settings-vor-update.json)
  hyhy-settings-guard restore  [DATEI]   Werte aus der Sicherung zurückschreiben: jeder Schlüssel der Sicherung gewinnt, neue Schlüssel
                                       der neuen Version bleiben. Gibt die zurückgesetzten Schlüssel aus.
  hyhy-settings-guard check    [DATEI]   nur zeigen, was abweicht"""
import json, os, shutil, sys, time
from pathlib import Path

CUR = Path.home() / ".local/state/hypr-hypr/settings.json"
DEF = Path.home() / ".local/share/hypr-hypr-backups/settings-vor-update.json"


def load(p):
    data = json.loads(Path(p).read_text())
    if not isinstance(data, dict):
        raise ValueError("kein JSON-Objekt")
    return data


def write_atomic(path, text):
    """Erst in eine Nachbardatei schreiben, dann ersetzen: ein Abbruch mittendrin lässt nie eine halbe Datei zurück."""
    path = Path(path)
    tmp = path.with_name(path.name + ".tmp-%d" % os.getpid())
    try:
        tmp.write_text(text)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def prune(pattern_dir, prefix, keep=5):
    """Alte .vor-restore-Sicherungen aufräumen (jede Wiederherstellung legt eine an)."""
    old = sorted(Path(pattern_dir).glob(prefix + "*"), key=lambda p: p.stat().st_mtime, reverse=True)
    for p in old[keep:]:
        p.unlink(missing_ok=True)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "check"
    src = Path(a[1]) if len(a) > 1 else DEF
    if cmd == "snapshot":
        if not CUR.exists():
            return
        try:
            load(CUR)
        except (OSError, ValueError):
            print("settings.json ist beschädigt – keine Sicherung überschrieben", file=sys.stderr); return
        src.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(src, CUR.read_text())
        print("gesichert:", src)
        return
    if cmd in ("restore", "check"):
        try:
            snap = load(src)
        except (OSError, ValueError) as e:
            print("Keine brauchbare Sicherung:", e, file=sys.stderr); sys.exit(1)
        try:
            cur = load(CUR)
        except FileNotFoundError:
            # Die Einstellungen sind ganz verschwunden (z. B. von einer Aktualisierung gelöscht): aus der Sicherung neu anlegen
            if cmd == "check":
                print("settings.json fehlt"); return
            CUR.parent.mkdir(parents=True, exist_ok=True)
            write_atomic(CUR, json.dumps(snap, indent=4, ensure_ascii=False))
            print("settings.json fehlte – aus der Sicherung wiederhergestellt"); return
        except (OSError, ValueError) as e:
            # Beschädigt: die kaputte Datei aufheben und die Sicherung einsetzen, statt sie weiter zu benutzen
            if cmd == "check":
                print("settings.json ist beschädigt:", e); return
            shutil.copy2(CUR, str(CUR) + ".defekt-" + time.strftime("%Y%m%d-%H%M%S"))
            write_atomic(CUR, json.dumps(snap, indent=4, ensure_ascii=False))
            print("settings.json war beschädigt – aus der Sicherung wiederhergestellt (die defekte Datei liegt daneben)"); return
        diff = [k for k, v in snap.items() if cur.get(k) != v]
        if cmd == "check":
            print("\n".join(diff) or "keine Abweichung"); return
        if not diff:
            print("nichts zurückzusetzen"); return
        shutil.copy2(CUR, str(CUR) + ".vor-restore-" + time.strftime("%Y%m%d-%H%M%S"))
        prune(CUR.parent, CUR.name + ".vor-restore-")
        for k in diff:
            cur[k] = snap[k]
        write_atomic(CUR, json.dumps(cur, indent=4, ensure_ascii=False))
        print("zurückgesetzt auf deine Werte:", ", ".join(diff))
        return
    print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
