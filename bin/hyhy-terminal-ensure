#!/usr/bin/env bash
# Hypr Hypr: sorgt dafür, dass IMMER mindestens ein Terminal installiert ist. Du kannst Ghostty, Kitty & Co. frei deinstallieren –
# solange ein anderes Terminal da ist, passiert nichts. Fehlt das letzte, wird Ghostty installiert (Passwort per Dialog).
# Außerdem: zeigt die Einstellung auf ein nicht (mehr) installiertes Terminal, wird sie auf ein vorhandenes umgestellt.
#   hyhy-terminal-ensure [--quiet]
TERMS=(ghostty kitty foot alacritty wezterm konsole gnome-terminal xfce4-terminal tilix xterm)
CFG="$HOME/.config/hypr-hypr/terminal"
first=""; for t in "${TERMS[@]}"; do command -v "$t" >/dev/null 2>&1 && { first="$t"; break; }; done
if [ -n "$first" ]; then
  cur="$(head -1 "$CFG" 2>/dev/null | tr -d '[:space:]')"
  if [ -z "$cur" ] || ! command -v "$cur" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$CFG")"; echo "$first" > "$CFG"
    [ "$1" = "--quiet" ] || echo "Terminal-Einstellung auf $first gesetzt (vorher: ${cur:-leer})"
  fi
  exit 0
fi
# kein Terminal da: höchstens einmal pro Stunde versuchen (kein Dialog-Dauerfeuer)
RT="${XDG_RUNTIME_DIR:-}"; [ -n "$RT" ] && [ -d "$RT" ] || RT="$HOME/.cache/draconyx"; mkdir -p "$RT"
exec 9>"$RT/draconyx-terminal-ensure.lock"; flock -n 9 || exit 0          # nur ein Versuch gleichzeitig (kein doppelter Passwortdialog)
STAMP="$RT/draconyx-terminal-ensure"
now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0;; esac
[ $((now - last)) -lt 3600 ] && exit 0
echo "$now" > "$STAMP"
command -v pacman >/dev/null 2>&1 || { echo "Kein Terminal installiert und kein pacman vorhanden – bitte von Hand eins installieren." >&2; exit 1; }
notify-send -a "Hypr Hypr" -i utilities-terminal "Kein Terminal installiert" "Ghostty wird installiert – gleich fragt ein Fenster nach deinem sudo-Passwort." 2>/dev/null
export SUDO_ASKPASS="$HOME/.local/bin/hyhy-askpass"
if [ -x "$SUDO_ASKPASS" ] && sudo -A pacman -S --needed --noconfirm ghostty; then
  echo ghostty > "$CFG"
  notify-send -a "Hypr Hypr" -i utilities-terminal "Ghostty installiert" "Es war kein Terminal mehr vorhanden." 2>/dev/null
else
  notify-send -a "Hypr Hypr" -u critical -i utilities-terminal "Terminal konnte nicht installiert werden" "Bitte von Hand:  sudo pacman -S ghostty" 2>/dev/null
  exit 1
fi
