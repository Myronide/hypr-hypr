#!/usr/bin/env python3
# Hypr Hypr: Update-Prüfung und -Installation für das System selbst (das Git-Repo, aus dem installiert wurde).
#   hyhy-update check [--quiet]   beim Remote nachsehen, ob es eine neuere Version gibt (schreibt ~/.local/state/hypr-hypr/update.json)
#   hyhy-update status            gespeicherten Stand zeigen
#   hyhy-update apply             im Hintergrund aktualisieren (nur der sudo-Dialog erscheint); Meldungen als Benachrichtigung,
#                               Protokoll: ~/.cache/hypr-hypr/update.log     --fg: im Vordergrund    --terminal: sichtbar im Terminal
# Die installierte Version und der Repo-Pfad stehen in ~/.config/hypr-hypr/install.json (schreibt der Installer).
import json, os, re, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
# Neue Ordner: hypr-hypr. Die alten draconyx-Pfade funktionieren bis 1.x weiter (Symlinks, siehe bin/hyhy-paths).
INSTALL = next((p for p in (HOME / ".config/hypr-hypr/install.json", HOME / ".config/draconyx/install.json") if p.exists()),
               HOME / ".config/hypr-hypr/install.json")
STATE = HOME / ".local/state/hypr-hypr/update.json"

def read_json(p, default):
    try: return json.loads(p.read_text())
    except (OSError, ValueError): return default

def vkey(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3]) + (0,) * (3 - len(re.findall(r"\d+", v)[:3]))

def git_env():
    """Git darf nie auf eine Eingabe warten (Passwort, Host-Schlüssel): im Hintergrund sieht sie niemand und der Aufruf hinge für immer."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", LC_ALL="C")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=10")
    return env

def git(repo, *args, timeout=40):
    try:
        return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=timeout, env=git_env())
    except FileNotFoundError:
        raise OSError("git ist nicht installiert (Paket git)")


def changelog(text, installed, latest):
    """Abschnitte "## x.y.z" aus dem CHANGELOG, die neuer als die installierte Version sind (bis zur neuesten): [{version, items[]}]"""
    out, cur = [], None
    for line in text.splitlines():
        m = re.match(r"##\s+(\d+\.\d+\.\d+)", line)
        if m:
            cur = {"version": m.group(1), "items": []}
            out.append(cur)
        elif cur is not None and line.strip().startswith("-"):
            cur["items"].append(line.strip().lstrip("-").strip())
        elif cur is not None and line.startswith("  ") and cur["items"]:
            cur["items"][-1] += " " + line.strip()                      # fortgesetzte Zeile
    return [c for c in out if vkey(installed) < vkey(c["version"]) <= vkey(latest)]

def check():
    info = read_json(INSTALL, {})
    repo = Path(info["repo"]) if info.get("repo") else None          # Path("") wäre der aktuelle Ordner und würde dessen .git prüfen
    out = {"installed": info.get("version", "?"), "latest": info.get("version", "?"), "available": False, "notes": [], "checked": int(time.time()), "error": ""}
    if repo is None or not (repo / ".git").exists():
        out["error"] = "noch nicht mit install.sh eingerichtet – im Repo einmal  sudo ./install.sh  ausführen" if not info else "Repo-Ordner nicht mehr vorhanden – install.sh aus dem neuen Repo starten"
    else:
        try:
            # Billige Vorprüfung (jede Minute): stimmt der Stand des Remotes mit dem lokalen origin/... überein, nichts holen
            up0 = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}").stdout.strip() or "origin/master"
            br = up0.split("/", 1)[-1]
            lr = git(repo, "ls-remote", "origin", "refs/heads/" + br, timeout=20)
            remote_sha = lr.stdout.split()[0] if lr.returncode == 0 and lr.stdout.split() else ""
            local_sha = git(repo, "rev-parse", up0).stdout.strip()
            skip_fetch = bool(remote_sha) and remote_sha == local_sha        # nichts Neues am Remote: nicht holen (die Auswertung unten läuft trotzdem)
            f = git(repo, "fetch", "--quiet", "origin") if not skip_fetch else subprocess.CompletedProcess([], 0, "", "")
            if f.returncode != 0:
                out["error"] = (f.stderr.strip().splitlines() or ["fetch fehlgeschlagen"])[-1]
            else:
                up = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}").stdout.strip() or "origin/master"
                latest = git(repo, "show", up + ":VERSION").stdout.strip() or out["installed"]
                out["latest"] = latest
                out["available"] = vkey(latest) > vkey(out["installed"])
                log = git(repo, "log", "--format=%s", "-n", "8", "HEAD.." + up).stdout.strip().splitlines()
                out["notes"] = log
                out["changelog"] = changelog(git(repo, "show", up + ":CHANGELOG.md").stdout, out["installed"], latest)
        except (subprocess.TimeoutExpired, OSError) as e:
            out["error"] = str(e)
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")                                  # atomar: die Shell liest die Datei, während wir schreiben
        tmp.write_text(json.dumps(out, ensure_ascii=False, indent=2))
        tmp.replace(STATE)
    except OSError as e:
        out["error"] = out["error"] or "Stand konnte nicht gespeichert werden: %s" % e
    return out


LOG = HOME / ".cache/hypr-hypr/update.log"
PROGRESS = HOME / ".cache/hypr-hypr/update-progress.json"

def progress(percent, text, state="running"):
    """Stand für die Anzeige oben rechts (UpdateProgress.qml in der Shell) schreiben."""
    try:
        PROGRESS.parent.mkdir(parents=True, exist_ok=True)
        tmp = PROGRESS.with_suffix(".tmp")
        tmp.write_text(json.dumps({"state": state, "percent": percent, "text": text, "ts": int(time.time())}, ensure_ascii=False))
        tmp.replace(PROGRESS)
    except OSError:
        pass

def notify(title, body="", urgent=False):
    try:
        subprocess.run(["notify-send", "-a", "Hypr Hypr", "-i", "system-software-update"] + (["-u", "critical"] if urgent else []) + [title, body],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass                                                             # ohne notify-send/Benachrichtigungsdienst läuft das Update trotzdem

def sync_repo(repo, log):
    """Repo auf den Stand des Remotes bringen, ohne etwas zu verlieren: eigene Änderungen werden vorher gesichert."""
    def g(*a, check=True):
        r = git(repo, *a, timeout=120)
        log.write("$ git %s\n%s%s\n" % (" ".join(a), r.stdout, r.stderr)); log.flush()
        if check and r.returncode != 0:
            raise RuntimeError("git %s fehlgeschlagen: %s" % (next(x for x in a if not x.startswith("-") and "=" not in x), (r.stderr.strip().splitlines() or ["?"])[-1]))
        return r
    progress(8, "Hole den neuen Stand …")
    g("fetch", "origin")
    progress(14, "Sichere lokale Änderungen und gleiche ab …")
    up = g("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", check=False).stdout.strip() or "origin/master"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    if g("status", "--porcelain", check=False).stdout.strip():                    # lokale Änderungen im Repo: sichern, nicht löschen
        # Ohne user.name/user.email (frisches System) scheitert "git stash"; dann dürfte unten kein "reset --hard" folgen: lieber abbrechen
        g("-c", "user.name=Draconyx", "-c", "user.email=draconyx@localhost", "stash", "push", "--include-untracked", "-m", "hyhy-update " + stamp)
        log.write("(lokale Änderungen im Repo gesichert: git stash list)\n")
    if g("merge", "--ff-only", up, check=False).returncode != 0:               # Verlauf weicht ab (z. B. neu geschrieben): alten Stand merken
        g("branch", "hyhy-vor-update-" + stamp, "HEAD", check=False)
        g("reset", "--hard", up)
        log.write("(Verlauf wich ab – alter Stand liegt als Branch hyhy-vor-update-%s)\n" % stamp)

def apply(foreground=False, terminal=False):
    info = read_json(INSTALL, {})
    repo = info.get("repo", "")
    if not repo or not Path(repo).is_dir():
        notify("Hypr Hypr-Update nicht möglich", "Repo nicht gefunden – im Repo einmal sudo ./install.sh ausführen.", True); sys.exit(1)
    if terminal:                                                                    # sichtbar in einem Terminal (z. B. Ghostty)
        os.execvp(str(HOME / ".local/bin/hyhy-terminal"), ["hyhy-terminal", "--", sys.executable, __file__, "apply", "--fg"])
    if not foreground and not os.environ.get("DX_UPDATE_CHILD"):                   # in den Hintergrund: eigener Prozess, ohne Terminal
        env = dict(os.environ, DX_UPDATE_CHILD="1")
        subprocess.Popen([sys.executable, __file__, "apply"], env=env, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    import fcntl
    rt = os.environ.get("XDG_RUNTIME_DIR") or str(HOME / ".cache/hypr-hypr")     # nie ein vorhersagbarer Name in /tmp
    os.makedirs(rt, exist_ok=True)
    lockf = open(os.path.join(rt, "draconyx-update.lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        notify("Hypr Hypr-Update läuft schon"); return
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "w") as log:
        log.write("Hypr Hypr-Update %s\n" % time.strftime("%F %T"))
        old = info.get("version", "?")
        progress(3, "Starte …")
        notify("Hypr Hypr wird aktualisiert …", "Alles läuft im Hintergrund. Gleich fragt ein kleines Fenster nach deinem sudo-Passwort.")
        try:
            sync_repo(repo, log)
            # 2.x nur ab 1.6.3 installiert (bin/hyhy-paths gate); sonst bricht der Wechsel der Ordnernamen
            newv = (Path(repo) / "VERSION").read_text().strip() if (Path(repo) / "VERSION").exists() else ""
            gate_bin = Path(repo) / "bin/hyhy-paths"                     # ältere Repos ohne den Helfer: keine 2.x-Sperre nötig
            if gate_bin.exists():
                gate = subprocess.run([str(gate_bin), "gate", newv], capture_output=True, text=True)
                if gate.returncode != 0:
                    log.write(gate.stdout + gate.stderr)
                    raise RuntimeError(gate.stdout.strip() or "Update auf %s blockiert" % newv)
            env = dict(os.environ, SUDO_ASKPASS=str(HOME / ".local/bin/hyhy-askpass"), DX_UPDATE_RUN="1")
            if not (HOME / ".local/bin/hyhy-askpass").exists():
                env["SUDO_ASKPASS"] = str(Path(repo) / "bin/hyhy-askpass")
            # Der Installer sichert und überschreibt keine Einstellungen (siehe install.sh) und startet die Shell am Ende neu.
            # --keep-config: bei einem Update wird eine fremde hyprland.lua nie ersetzt (nur eine unveränderte eigene Fassung wird aktualisiert).
            progress(18, "Warte auf dein sudo-Passwort …")
            proc = subprocess.Popen(["sudo", "-A", str(Path(repo) / "install.sh"), "--yes", "--keep-config"], cwd=repo, env=env,
                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
            steps = 0                                           # der Installer meldet jeden Schritt mit "==>"; daran messen wir den Fortschritt
            for line in proc.stdout:
                log.write(line); log.flush()
                clean = re.sub(r"\x1b\[[0-9;]*m", "", line).strip()
                if clean.startswith("==>"):
                    steps += 1
                    progress(20 + 74 * min(1.0, steps / 14.0), clean[3:].strip()[:90])
            rc = proc.wait()
        except Exception as e:
            log.write("FEHLER: %s\n" % e); rc = 1
    new = read_json(INSTALL, {}).get("version", old)
    if rc == 0:
        notify("Hypr Hypr aktualisiert", "Version %s%s" % (new, "" if new == old else " (vorher %s)" % old))
        check()
        progress(100, "Version %s%s" % (new, "" if new == old else " (vorher %s)" % old), "done")
    else:
        progress(100, "Update fehlgeschlagen – deine Einstellungen sind unverändert (Protokoll: update.log)", "error")
        notify("Hypr Hypr-Update fehlgeschlagen", "Deine Einstellungen sind unverändert (Sicherungen: ~/.local/share/hypr-hypr-backups). Protokoll: %s" % LOG, True)
        sys.exit(rc)

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "check":
        o = check()
        if "--quiet" not in sys.argv:
            print("installiert: %s  neueste: %s  %s" % (o["installed"], o["latest"], "→ UPDATE VERFÜGBAR" if o["available"] else "(aktuell)"))
            if o["error"]: print("Hinweis:", o["error"])
        print(json.dumps(o, ensure_ascii=False)) if "--json" in sys.argv else None
    elif cmd == "status":
        print(json.dumps(read_json(STATE, {}), ensure_ascii=False, indent=2))
    elif cmd == "apply":
        apply(foreground="--fg" in sys.argv, terminal="--terminal" in sys.argv)
    else:
        print(__doc__); sys.exit(2)

if __name__ == "__main__":
    main()
