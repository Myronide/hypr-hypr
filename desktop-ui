def history_db():
    HISTORY.mkdir(parents=True,exist_ok=True,mode=0o700)
    os.chmod(HISTORY,0o700)
    db=sqlite3.connect(HISTORY/'clipboard.sqlite3',timeout=5)
    db.execute('CREATE TABLE IF NOT EXISTS clips (hash TEXT PRIMARY KEY, mime TEXT, data BLOB, updated REAL)')
    os.chmod(HISTORY/'clipboard.sqlite3',0o600)
    return db
if len(sys.argv)>1 and sys.argv[1]=='clipboard-store':
    if os.environ.get('CLIPBOARD_STATE') in ('nil','clear','sensitive'):sys.exit(0)
    data=sys.stdin.buffer.read(5*1024*1024+1)
    if not data or len(data)>5*1024*1024:sys.exit(0)
    mime='image/png' if sys.argv[2]=='image/png' else 'text/plain;charset=utf-8'
    with history_db() as db:
        db.execute('INSERT OR REPLACE INTO clips VALUES (?,?,?,?)',(hashlib.sha256(data).hexdigest(),mime,data,time.time()))
        db.execute('DELETE FROM clips WHERE hash NOT IN (SELECT hash FROM clips ORDER BY updated DESC LIMIT 100)')
        while db.execute('SELECT coalesce(sum(length(data)),0) FROM clips').fetchone()[0]>30*1024*1024:
            db.execute('DELETE FROM clips WHERE hash = (SELECT hash FROM clips ORDER BY updated LIMIT 1)')
    sys.exit(0)
