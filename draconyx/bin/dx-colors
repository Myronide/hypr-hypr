#!/usr/bin/env python3
"""Gemeinsame Farbwelt für Aurora und die Shell.
  dx-colors preset aurora|draconyx   Voreinstellung wählen
  dx-colors accent '#4d8fe0'         Akzentfarbe ändern (Hell/Dunkel werden abgeleitet)
  dx-colors set bg '#262a30'         einzelne Farbe (bg surface hover border text muted accent accentBright accentDeep selected)
  dx-colors show | ensure
Schreibt ~/.config/draconyx/colors.json (die Shell lädt sie live), Symbol-Sätze und Auroras palette.css."""
import json, os, re, sys, colorsys
from pathlib import Path
HOME = Path.home()
CONF = HOME / ".config/draconyx/colors.json"
SRC = HOME / ".local/share/draconyx-hypr/qs-icons-src"
OUT = HOME / ".local/share/draconyx-hypr/icons"
AURORA = HOME / ".config/hypr/aurora"
PRESETS = {
  "aurora":    dict(bg="#262a30", surface="#30353d", hover="#3a414b", border="#424a55", text="#edf1f7", muted="#a6b0be",
                    accent="#4d8fe0", accentBright="#6ba9ff", accentDeep="#397acb", selected="#355a86"),
  "draconyx":  dict(bg="#0d0b17", surface="#14112a", hover="#1c1838", border="#3a2f66", text="#ece9f7", muted="#9a95b8",
                    accent="#8b5cf6", accentBright="#a78bfa", accentDeep="#5b3fd0", selected="#3b2d7a"),
}
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")
def load():
    try: return json.loads(CONF.read_text())
    except (OSError, ValueError): return dict(PRESETS["aurora"], preset="aurora")
def shade(h, dl=0.0, ds=0.0):
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (1, 3, 5))
    hh, l, s = colorsys.rgb_to_hls(r, g, b)
    l = max(0, min(1, l + dl)); s = max(0, min(1, s + ds))
    r, g, b = colorsys.hls_to_rgb(hh, l, s)
    return "#%02x%02x%02x" % (round(r*255), round(g*255), round(b*255))
def icons(c):
    key = c["text"][1:] + "-" + c["accent"][1:]
    d = OUT / key
    if not d.exists():
        d.mkdir(parents=True)
        for f in SRC.glob("*.svg"):
            (d / f.name).write_text(f.read_text().replace("@TEXT@", c["text"]).replace("@ACCENT@", c["accent"]))
    return key
def write(c, palette=True):
    for k in PRESETS["aurora"]:
        if not HEX.match(c.get(k, "")): raise SystemExit("Ungültige Farbe für " + k)
    c["iconKey"] = icons(c)
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix(".tmp"); tmp.write_text(json.dumps(c, indent=2)); tmp.replace(CONF)
    if palette and AURORA.is_dir():
        (AURORA / "palette.css").write_text(
          "@define-color shell_bg %(bg)s;\n@define-color shell_surface %(surface)s;\n@define-color shell_hover %(hover)s;\n"
          "@define-color shell_border %(border)s;\n@define-color shell_text %(text)s;\n@define-color shell_muted %(muted)s;\n"
          "@define-color shell_blue %(accentBright)s;\n@define-color shell_selected %(selected)s;\n@define-color shell_accent %(accent)s;\n@define-color shell_accent_deep %(accentDeep)s;\n" % c)
def main(a):
    if not a or a[0] == "show": print(json.dumps(load(), indent=2)); return
    c = load()
    if a[0] == "ensure":
        # vorhandene Farbdatei NIE neu schreiben: nur dafür sorgen, dass der passende Symbolsatz existiert
        if CONF.exists():
            try:
                cc = json.loads(CONF.read_text())
                if all(HEX.match(cc.get(k, "")) for k in PRESETS["aurora"]): icons(cc)
            except (OSError, ValueError):
                print("colors.json nicht lesbar – bleibt unverändert", file=sys.stderr)
        else:
            write(c, palette=False)
    elif a[0] == "preset" and a[1] in PRESETS: c = dict(PRESETS[a[1]], preset=a[1]); write(c)
    elif a[0] == "accent":
        h = a[1] if a[1].startswith("#") else "#" + a[1]
        c.update(accent=h, accentBright=shade(h, .12), accentDeep=shade(h, -.1), selected=shade(h, -.28, -.15), preset="custom"); write(c)
    elif a[0] == "set" and a[1] in PRESETS["aurora"]:
        c[a[1]] = a[2] if a[2].startswith("#") else "#" + a[2]; c["preset"] = "custom"; write(c)
    else: raise SystemExit(__doc__)
main(sys.argv[1:])
