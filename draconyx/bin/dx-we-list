#!/usr/bin/env python3
# Draconyx: listet alle Steam-Workshop-Wallpaper der Wallpaper Engine als TSV: id, titel, typ, vorschau-pfad, geändert
# Suchorte (alle zusammen): Ordner aus ~/.config/draconyx/workshop, Aurora-Einstellung "workshop",
# alle Steam-Bibliotheken (libraryfolders.vdf) und gängige Einhängepunkte.
import glob, json, os, re
APP = "431960"
home = os.path.expanduser("~")
roots = []
def add(p):
    p = os.path.expanduser(p.strip())
    if p and p not in roots: roots.append(p)
try:
    add(open(home + "/.config/draconyx/workshop").read())
except OSError:
    pass
try:
    add(json.load(open(home + "/.config/hypr/aurora/preferences.json")).get("workshop", ""))
except (OSError, ValueError):
    pass
for vdf in (home + "/.local/share/Steam/steamapps/libraryfolders.vdf", home + "/.steam/steam/steamapps/libraryfolders.vdf"):
    try:
        for m in re.finditer(r'"path"\s+"([^"]+)"', open(vdf, encoding="utf-8", errors="replace").read()):
            add(m.group(1) + "/steamapps/workshop/content/" + APP)
    except OSError:
        pass
add(home + "/.local/share/Steam/steamapps/workshop/content/" + APP)
for pat in ("/run/media/*/*/SteamLibrary", "/run/media/*/*/steamapps", "/mnt/*/SteamLibrary", "/mnt/*/Steam*", "/mnt/SteamLibrary",
            "/media/*/SteamLibrary", "/media/*/*/SteamLibrary", "/media/*/steamapps"):
    for p in glob.glob(pat):
        add(p + ("" if p.endswith("steamapps") else "/steamapps") + "/workshop/content/" + APP)
seen = set()
for root in roots:
    if not os.path.isdir(root):
        continue
    for d in sorted(os.listdir(root)):
        if d in seen:
            continue
        base = os.path.join(root, d)
        try:
            j = json.load(open(os.path.join(base, "project.json"), encoding="utf-8", errors="replace"))
        except Exception:
            continue
        seen.add(d)
        title = (j.get("title") or d).replace("\t", " ").replace("\n", " ")
        typ = (j.get("type") or "?").lower()
        prev = j.get("preview") or ""
        prev_path = os.path.join(base, prev) if prev else ""
        if prev_path and not os.path.exists(prev_path):
            prev_path = ""
        try:
            mt = int(os.path.getmtime(base))
        except OSError:
            mt = 0
        print("\t".join([d, title, typ, prev_path, str(mt)]))
