+void WaylandMouseInput::refreshHyprlandMonitors () {
+    const std::string response = this->hyprlandRequest ("j/monitors");
+    if (response.empty ()) {
+	return;
+    }
+
+    std::vector<HyprMonitor> result;
+    static const std::regex nameRe (R"x("name"\s*:\s*"([^"]+)")x");
+    static const std::regex numRe (R"x("(width|height|x|y|scale)"\s*:\s*(-?\d+(?:\.\d+)?))x");
+
+    // Ein Objekt je Monitor: an '"id":' trennen
+    std::size_t pos = 0;
+    while (true) {
+	const std::size_t start = response.find ("\"id\"", pos);
+	if (start == std::string::npos) {
+	    break;
+	}
+	std::size_t end = response.find ("\"id\"", start + 4);
+	if (end == std::string::npos) {
+	    end = response.size ();
+	}
+	const std::string chunk = response.substr (start, end - start);
+	pos = end;
+
+	HyprMonitor m;
+	std::smatch nm;
+	if (!std::regex_search (chunk, nm, nameRe)) {
+	    continue;
+	}
+	m.name = nm[1].str ();
+	for (std::sregex_iterator it (chunk.begin (), chunk.end (), numRe), last; it != last; ++it) {
+	    const std::string key = (*it)[1].str ();
+	    const double value = std::stod ((*it)[2].str ());
+	    if (key == "width") m.w = value;
+	    else if (key == "height") m.h = value;
+	    else if (key == "x") m.x = value;
+	    else if (key == "y") m.y = value;
+	    else if (key == "scale") m.scale = value > 0 ? value : 1;
+	}
+	if (m.w > 0 && m.h > 0) {
+	    result.push_back (m);
+	}
+    }
+
+    if (!result.empty ()) {
+	this->m_hyprMonitors = result;
+    }
+}
