-- Vorlage für die Monitore dieses Rechners (Kopie nach ~/.config/hypr/monitors_local.lua).
-- Du musst das NICHT von Hand machen: der Installer erkennt deine Bildschirme selbst, und in den Aurora-Einstellungen
-- unter „Bildschirme“ ordnest du sie wie unter Windows an. Namen anzeigen:  dx-monitors show   (oder  hyprctl monitors)

hl.monitor({
    output   = "DP-1",              -- Name aus `dx-monitors show`
    mode     = "1920x1080@60",
    position = "0x0",
    scale    = 1,
    -- Optional: bitdepth = 10, cm = "hdr", vrr = 1, transform = 1 (gedreht)
})

-- Alles andere (z. B. ein neu angeschlossener Monitor): rechts anhängen
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
