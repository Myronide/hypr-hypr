 def system(self):
  b=self.page('System','Aktualisierung von Draconyx und weitere Helfer.')
  # ---- Draconyx-Update: alles in EINER Zeile (Version, Stand, Knopf – der Knopf erscheint nur, wenn es ein Update gibt) ----
  upd=Path.home()/'.local/state/draconyx/update.json'
  def upd_info():
   try:return json.loads(upd.read_text())
   except (OSError,ValueError):return {}
  vl=Gtk.Label(xalign=1);vl.set_line_wrap(True);vl.set_max_width_chars(40);vl.set_justify(Gtk.Justification.RIGHT)
  ub=Gtk.Button(label='Jetzt aktualisieren');ub.get_style_context().add_class('suggested-action');ub.set_no_show_all(True)
  def show(i):
   notes='\n'.join('• '+n for n in (i.get('notes') or [])[:8])
   vl.set_tooltip_text(notes or None)
   if not i:vl.set_text('Prüfe …')
   elif i.get('error'):vl.set_text('Version %s – Prüfung nicht möglich'%i.get('installed','?'));vl.set_tooltip_text(i['error'])
   elif i.get('available'):vl.set_text('Version %s – neu: %s'%(i.get('installed','?'),i.get('latest','?')))
   else:vl.set_text('Version %s – aktuell'%i.get('installed','?'))
   ub.set_visible(bool(i.get('available')) and not i.get('error'))
  def check_bg():
   def work():
    run_quiet([str(Path.home()/'.local/bin/dx-update'),'check','--quiet'],120)
    GLib.idle_add(show,upd_info())
   threading.Thread(target=work,daemon=True).start()
  def run_update(*_):
   subprocess.Popen([str(Path.home()/'.local/bin/dx-update'),'apply'],start_new_session=True);ub.set_sensitive(False);vl.set_text('Update läuft im Hintergrund – Fortschritt oben rechts');GLib.timeout_add_seconds(30,lambda:(ub.set_sensitive(True),False)[1])
  ub.connect('clicked',run_update)
  cb=Gtk.Button(label='Jetzt prüfen');cb.connect('clicked',lambda *_:(vl.set_text('Prüfe …'),check_bg()))
  uw=Gtk.Box(spacing=10);uw.pack_start(vl,True,True,0);uw.pack_end(ub,False,False,0);uw.pack_end(cb,False,False,0);uw.show_all()
  info=upd_info();show(info)
  # automatisch im Hintergrund prüfen: beim Öffnen (wenn die letzte Prüfung älter als 10 Minuten ist) und danach jede Minute den Stand neu lesen
  import time as _t
  if not info or _t.time()-info.get('checked',0)>600:check_bg()
  GLib.timeout_add_seconds(60,lambda:(show(upd_info()),True)[1])
  self.row(b,'Draconyx-Version',uw,'Wird automatisch im Hintergrund geprüft (jede Minute, die Meldung höchstens einmal pro Tag), „Jetzt prüfen“ sofort. Bei einem Update erscheint hier der Knopf; die Aktualisierung läuft ohne Terminal (nur ein Fenster für das sudo-Passwort), deine Einstellungen bleiben unangetastet.')
  self.sw(b,'Update-Benachrichtigungen','updateNotify',True,'Höchstens eine Meldung pro Tag, solange ein Update bereitsteht („Nicht mehr erinnern“ in der Meldung gilt nur für diese Version). Aus: gar keine Meldungen mehr – die Zeile oben zeigt ein Update trotzdem an.')
  for title,args in [('Steam Workshop',['steam','steam://url/SteamWorkshopPage/431960'])]:self.button(b,title,'Öffnen',lambda args=args:subprocess.Popen(args))
