  names=dict(self.BAR_ITEMS);secnames={'left':'Links','center':'Mitte','right':'Rechts'}
  def save(lay):
   m=dict(shell_get('barLayouts',{}) or {});m[style]=lay;shell_set('barLayouts',m)
  def build():
   for c in box.get_children():box.remove(c)
   lay=self.current_layout(style)
   for sec in ('left','center','right'):
    h=Gtk.Label(label=secnames[sec]+('' if lay[sec] else '  (leer)'),xalign=0);h.get_style_context().add_class('subtitle');box.pack_start(h,False,False,4)
    for idx,i in enumerate(lay[sec]):
     row=Gtk.Box(spacing=8);row.get_style_context().add_class('setting-row');l=Gtk.Label(label=names[i],xalign=0);row.pack_start(l,True,True,0)
     def move(w,i=i,sec=sec,d=0,tosec=None):
