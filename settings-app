 def bind_editor(self,b):
  reg=Path.home()/'.config/draconyx/binds-registry.tsv';conf=Path.home()/'.config/draconyx/binds.conf'
  rows=[]
  try:
   for line in reg.read_text().splitlines():
    p=line.split('\t')
    if len(p)>=3:rows.append((p[0],p[1],p[2],p[3] if len(p)>3 else p[2]))
  except OSError:pass
  over={}
  try:
   for line in conf.read_text().splitlines():
    if '=' in line:k,v=line.split('=',1);over[k.strip()]=v.strip()
  except OSError:pass
  head=Gtk.Label(label='Alle Tastenkombinationen',xalign=0);head.get_style_context().add_class('page-title');b.pack_start(head,False,False,6)
  if not rows:
   hint=Gtk.Label(label='Die Liste entsteht, sobald Hyprland die Konfiguration geladen hat (hyprctl reload oder neu anmelden).',xalign=0);hint.set_line_wrap(True);hint.get_style_context().add_class('subtitle');b.pack_start(hint,False,False,0);return
  search=Gtk.SearchEntry();search.set_placeholder_text('Aktion suchen …');b.pack_start(search,False,False,4)
  timer={'id':0};entries={}
  def save():
   conf.parent.mkdir(parents=True,exist_ok=True)
   conf.write_text(''.join('%s=%s\n'%(k,v) for k,v in over.items()))
   if timer['id']:GLib.source_remove(timer['id'])
   timer['id']=GLib.timeout_add(700,lambda:(subprocess.run(['hyprctl','reload'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL),timer.__setitem__('id',0),False)[2])
  def duplicate(aid,combo):
   if not combo:return None
   for rid,lab,dflt,_ in rows:
    if rid!=aid and over.get(rid,dflt)==combo:return lab
   return None
  def set_combo(aid,combo,default):
   dup=duplicate(aid,combo)
   if combo==default:over.pop(aid,None)
   else:over[aid]=combo
   entries[aid].set_text(combo)
   save()
   self.message(('Doppelt belegt mit „%s“ – bitte prüfen.'%dup) if dup else ('Gespeichert: '+(combo or 'ausgeschaltet')))
  widgets=[]
  for aid,label,default,effective in rows:
   current=over.get(aid,default)
   row=Gtk.Box(spacing=8);row.get_style_context().add_class('setting-row')
   lab=Gtk.Label(label=label,xalign=0);lab.set_line_wrap(True);lab.set_max_width_chars(46);row.pack_start(lab,True,True,0)
   e=Gtk.Entry(text=current);e.set_width_chars(26);e.set_editable(False);entries[aid]=e
   rec=Gtk.Button(label='Aufnehmen');rec.connect('clicked',lambda w,aid=aid,label=label,default=default:self.capture_combo(label,lambda c:set_combo(aid,c,default)))
   off=Gtk.Button(label='Aus');off.connect('clicked',lambda w,aid=aid,default=default:set_combo(aid,'',default))
