  for c in self.properties_box.get_children():c.destroy()
  for key,prop in row.project.get('general',{}).get('properties',{}).items():
   if prop.get('type')=='bool':
    w=Gtk.CheckButton(label=prop.get('text',key));w.set_active(bool(prop.get('value')));self.p['engine_properties'][key]={'value':w.get_active()};w.connect('toggled',lambda w,key=key:self.p['engine_properties'].__setitem__(key,{'value':w.get_active()}));self.properties_box.pack_start(w,False,False,0)
   elif prop.get('type')=='slider':
    value=prop.get('value',0);w=Gtk.SpinButton.new_with_range(float(prop.get('min',0)),float(prop.get('max',100)),float(prop.get('step',1)));w.set_value(float(value));self.p['engine_properties'][key]={'value':value};w.connect('value-changed',lambda w,key=key:self.p['engine_properties'].__setitem__(key,{'value':w.get_value()}));self.row(self.properties_box,prop.get('text',key),w)
  self.properties_box.show_all()
