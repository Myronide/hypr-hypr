 def default_layout(self,style):
  tools=['start','search','taskview','code','wallpaper','mode','desktops'];sysi=['update','tray','system','notifications','clock','settings','showDesktop']
  return {'left':[],'center':tools+['apps'],'right':sysi} if style=='dock' else {'left':tools,'center':['apps'],'right':sysi}
 def current_layout(self,style):
  saved=(shell_get('barLayouts',{}) or {}).get(style);default=self.default_layout(style)
  if not saved:return default
  ids=[i for i,_ in self.BAR_ITEMS];seen=set();out={'left':[],'center':[],'right':[]}
  for sec in out:
   for i in saved.get(sec,[]):
    if i in ids and i not in seen:seen.add(i);out[sec].append(i)
  for sec in out:
   for i in default[sec]:
    if i not in seen:seen.add(i);out[sec].append(i)
  return out
