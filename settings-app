 def __init__(self):
  super().__init__(orientation=Gtk.Orientation.HORIZONTAL,spacing=6)   # eine Reihe (ein FlowBox stapelte die Knöpfe in der schmalen Zeile untereinander)
  self.set_valign(Gtk.Align.CENTER);self.buttons={};self.active=None;self._lock=False
