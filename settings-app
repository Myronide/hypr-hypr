 BAR_ITEMS=[('start','Startknopf'),('search','Suche'),('taskview','Fensterübersicht'),('code','Coding Space'),('wallpaper','Wallpaper Engine'),
            ('mode','Fenstermodus-Knopf'),('desktops','Desktop-Punkte'),('apps','App-Symbole'),('tray','Tray'),('system','Netzwerk und Lautstärke'),
