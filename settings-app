class Choice(Gtk.Box):
 """Auswahl als Knopfreihe (für wenige Optionen; bei vielen: Select). GTK-Auswahllisten werden unter XWayland/Hyprland mittig im Fenster und fehlerhaft
 geöffnet. Gleiche Bedienung wie ComboBoxText (append, set_active_id, get_active_id, Signal 'changed')."""
 __gsignals__={'changed':(GObject.SignalFlags.RUN_FIRST,None,())}
 def __init__(self):
  super().__init__(orientation=Gtk.Orientation.HORIZONTAL,spacing=6)   # eine Reihe (ein FlowBox stapelte die Knöpfe in der schmalen Zeile untereinander)
  self.set_valign(Gtk.Align.CENTER);self.buttons={};self.active=None;self._lock=False
 def append(self,i,label):
  b=Gtk.ToggleButton(label=label);b.connect('toggled',self._toggled,i);self.buttons[i]=b;self.pack_start(b,False,False,0);b.show()
 def _toggled(self,b,i):
  if self._lock:return
  if b.get_active():self.set_active_id(i,True)
  elif self.active==i:
   self._lock=True;b.set_active(True);self._lock=False      # die gewählte Option bleibt gewählt
 def set_active_id(self,i,emit=False):
  self._lock=True
  for k,b in self.buttons.items():b.set_active(k==i)
  self._lock=False
  if i!=self.active and i in self.buttons:
   self.active=i
   if emit:self.emit('changed')
 def get_active_id(self):return self.active
 def clear(self):
  for b in list(self.buttons.values()):self.remove(b)
  self.buttons={};self.active=None

class Select(Gtk.MenuButton):
