 IDLE=Path.home()/'.config/hypr/hypridle.conf'
 def idle_read(self):
  """Minuten für sperren / Bildschirm aus / Standby (0 = nie) aus hypridle.conf"""
  out={'lock':0,'dpms':0,'sleep':0}
  try:text=self.IDLE.read_text()
  except OSError:return {'lock':15,'dpms':20,'sleep':0}
  for m in re.finditer(r'listener\s*\{(.*?)\}',text,re.S):
   body=m.group(1);t=re.search(r'timeout\s*=\s*(\d+)',body);c=re.search(r'on-timeout\s*=\s*(.*)',body)
   if not t or not c:continue
   mins=int(t.group(1))//60;cmd=c.group(1)
   if 'lock-session' in cmd or 'hyprlock' in cmd:out['lock']=mins
   elif 'dpms off' in cmd:out['dpms']=mins
   elif 'suspend' in cmd:out['sleep']=mins
  return out
 def idle_write(self,v):
  try:text=self.IDLE.read_text()
  except OSError:text='general {\n    lock_cmd = pidof hyprlock || hyprlock\n    before_sleep_cmd = loginctl lock-session\n    after_sleep_cmd = hyprctl dispatch dpms on\n}\n'
  def ours(m):
   c=re.search(r'on-timeout\s*=\s*(.*)',m.group(1));return bool(c) and bool(re.search(r'lock-session|hyprlock|dpms off|suspend',c.group(1)))
  keep=re.sub(r'\n?(?:#[^\n]*\n)*listener\s*\{(.*?)\}\n?',lambda m:'' if ours(m) else m.group(0),text,flags=re.S).rstrip('\n')+'\n'
  add=''
  if v['lock']>0:add+='\n# Sperren nach %d Minuten\nlistener {\n    timeout = %d\n    on-timeout = loginctl lock-session\n}\n'%(v['lock'],v['lock']*60)
  if v['dpms']>0:add+='\n# Bildschirme aus nach %d Minuten\nlistener {\n    timeout = %d\n    on-timeout = hyprctl dispatch dpms off\n    on-resume = hyprctl dispatch dpms on\n}\n'%(v['dpms'],v['dpms']*60)
  if v['sleep']>0:add+='\n# Standby nach %d Minuten\nlistener {\n    timeout = %d\n    on-timeout = systemctl suspend\n}\n'%(v['sleep'],v['sleep']*60)
  if self.IDLE.exists() and not getattr(self,'_idle_backed',False):
   shutil.copy2(self.IDLE,str(self.IDLE)+'.vor-'+time.strftime('%Y%m%d-%H%M%S'));self._idle_backed=True
  atomic_write(self.IDLE,keep+add)
  run_quiet(['pkill','-x','hypridle'],5)
  try:subprocess.Popen(['hypridle'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
  except OSError:self.message('hypridle ist nicht installiert – Zeiten gespeichert, aber nicht aktiv.')
