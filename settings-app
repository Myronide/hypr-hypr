 def clear(self):
  for b in list(self.buttons.values()):self.remove(b)
  self.buttons={};self.active=None

class LivePrefs(dict):
  """Einstellungen, die bei jeder Änderung selbst speichern/anwenden (kurz gebündelt) – statt eines „Übernehmen“-Knopfs."""
  on_change=None
  def __setitem__(self,k,v):
   changed=self.get(k,object())!=v
   super().__setitem__(k,v)
   if changed and self.on_change:self.on_change()

