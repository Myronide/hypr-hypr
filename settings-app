  self.scroll=Gtk.ScrolledWindow();self.scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC);self.scroll.set_propagate_natural_height(True);self.scroll.set_max_content_height(320);self.scroll.set_min_content_width(210)
  self.lb=Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE);self.lb.get_style_context().add_class('select-list');self.lb.connect('row-activated',self._row)
  self.scroll.add(self.lb);self.pop.add(self.scroll);self.scroll.show_all()
 def clear(self):
  for c in self.lb.get_children():self.lb.remove(c)
  self.items={};self.active=None;self.text.set_text('')
 def append(self,i,label):
  r=Gtk.ListBoxRow();r.value=i;l=Gtk.Label(label=label,xalign=0,margin=9);r.add(l);self.lb.add(r);r.show_all();self.items[i]=label
