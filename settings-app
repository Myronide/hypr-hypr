  self.text=Gtk.Label(xalign=0);self.text.set_ellipsize(Pango.EllipsizeMode.END);self.text.set_max_width_chars(28)
  row=Gtk.Box(spacing=10);row.pack_start(self.text,True,True,0);row.pack_end(Gtk.Image.new_from_icon_name('pan-down-symbolic',Gtk.IconSize.BUTTON),False,False,0)
  self.add(row);self.set_size_request(190,-1)
