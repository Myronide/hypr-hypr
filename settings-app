 # ---- alle Tastenkombinationen frei umbindbar (Liste kommt aus der laufenden Hyprland-Config: dx_binds.lua) ----
 KEYMAP={'Page_Up':'Prior','Page_Down':'Next','ISO_Left_Tab':'Tab','Return':'Return','KP_Enter':'KP_Enter','Escape':'Escape','BackSpace':'BackSpace'}
 def combo_from_key(self,event):
  from gi.repository import Gdk as _G
  name=_G.keyval_name(_G.keyval_to_lower(event.keyval)) or ''
  if name in ('Control_L','Control_R','Alt_L','Alt_R','Shift_L','Shift_R','Super_L','Super_R','Meta_L','Meta_R','ISO_Level3_Shift','Caps_Lock'):return None
  mods=[]
  st=event.state
  if st&_G.ModifierType.CONTROL_MASK:mods.append('CTRL')
  if st&_G.ModifierType.MOD1_MASK:mods.append('ALT')
  if st&_G.ModifierType.SHIFT_MASK:mods.append('SHIFT')
  if st&(_G.ModifierType.SUPER_MASK|_G.ModifierType.MOD4_MASK):mods.append('SUPER')
  key=self.KEYMAP.get(_G.keyval_name(event.keyval) or name,name)
  if len(key)==1:key=key.upper()
  return ' + '.join(mods+[key])
 def combo_from_button(self,event):
  from gi.repository import Gdk as _G
  mods=[]
  st=event.state
  if st&_G.ModifierType.CONTROL_MASK:mods.append('CTRL')
  if st&_G.ModifierType.MOD1_MASK:mods.append('ALT')
  if st&_G.ModifierType.SHIFT_MASK:mods.append('SHIFT')
  if st&(_G.ModifierType.SUPER_MASK|_G.ModifierType.MOD4_MASK):mods.append('SUPER')
  code={1:272,3:273,2:274,8:275,9:276}.get(event.button)
  return None if code is None else ' + '.join(mods+['mouse:%d'%code])
