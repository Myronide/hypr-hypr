       k=L[sec].index(i);j=k+d
       if 0<=j<len(L[sec]):L[sec][k],L[sec][j]=L[sec][j],L[sec][k]
      save(L);build()
     for label,kw in (('▲',{'d':-1}),('▼',{'d':1})):
      btn=Gtk.Button(label=label);btn.connect('clicked',lambda w,kw=kw,i=i,sec=sec:move(w,i,sec,**kw));row.pack_end(btn,False,False,0)
     for tosec in ('right','center','left'):
      if tosec!=sec:
       btn=Gtk.Button(label=secnames[tosec]);btn.connect('clicked',lambda w,tosec=tosec,i=i,sec=sec:move(w,i,sec,0,tosec));row.pack_end(btn,False,False,0)
     box.pack_start(row,False,False,0)
   reset=Gtk.Button(label='Anordnung zurücksetzen');reset.connect('clicked',lambda *_:(shell_set('barLayouts',{k:v for k,v in (shell_get('barLayouts',{}) or {}).items() if k!=style}),build()))
   box.pack_start(reset,False,False,6);box.show_all()
  build()

