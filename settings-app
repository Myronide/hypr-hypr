 BAR_ITEMS=[('start','Startknopf'),('search','Suche'),('taskview','Fensterübersicht'),('code','Coding Space'),('wallpaper','Wallpaper Engine'),
            ('mode','Fenstermodus-Knopf'),('desktops','Desktop-Punkte'),('apps','App-Symbole'),('tray','Tray'),('system','Netzwerk und Lautstärke'),
            ('notifications','Benachrichtigungen'),('clock','Uhr'),('settings','Einstellungen'),('showDesktop','Desktop-anzeigen-Streifen')]
 def default_layout(self,style):
  tools=['start','search','taskview','code','wallpaper','mode','desktops'];sysi=['tray','system','notifications','clock','settings','showDesktop']
  return {'left':[],'center':tools+['apps'],'right':sysi} if style=='dock' else {'left':tools,'center':['apps'],'right':sysi}
 def current_layout(self,style):
  saved=(shell_get('barLayouts',{}) or {}).get(style);default=self.default_layout(style)
  if not saved:return default
  ids=[i for i,_ in self.BAR_ITEMS];seen=set();out={'left':[],'center':[],'right':[]}
  for sec in out:
   for i in saved.get(sec,[]):
    if i in ids and i not in seen:seen.add(i);out[sec].append(i)
  for sec in out:
   for i in default[sec]:
    if i not in seen:seen.add(i);out[sec].append(i)
  return out
 def layout_editor(self,b):
  style=shell_get('barStyle','bar') or 'bar'
  head=Gtk.Label(label='Anordnung ('+('Schwebendes Dock' if style=='dock' else 'Durchgehende Leiste')+')',xalign=0);head.get_style_context().add_class('page-title');b.pack_start(head,False,False,6)
