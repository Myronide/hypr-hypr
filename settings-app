    if len(p)>=3:rows.append((p[0],p[1],p[2],p[3] if len(p)>3 else p[2]))
  except OSError:pass
  over={}
  try:
   for line in conf.read_text().splitlines():
    if '=' in line:k,v=line.split('=',1);over[k.strip()]=v.strip()
  except OSError:pass
  head=Gtk.Label(label='Alle Tastenkombinationen',xalign=0);head.get_style_context().add_class('page-title');b.pack_start(head,False,False,6)
  if not rows:
   hint=Gtk.Label(label='Die Liste entsteht, sobald Hyprland die Konfiguration geladen hat (hyprctl reload oder neu anmelden).',xalign=0);hint.set_line_wrap(True);hint.get_style_context().add_class('subtitle');b.pack_start(hint,False,False,0);return
