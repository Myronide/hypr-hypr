 def load_workshop(self):
  for r in self.workshop_list.get_children():r.destroy()
  folder=Path(self.p['workshop']).expanduser()
  if not folder.is_dir():self.message('Workshop-Ordner auswählen.');return
  items=[]
  for path in folder.iterdir():
   try:project=json.loads((path/'project.json').read_text());items.append((project.get('title',path.name),path,project))
   except (OSError,ValueError):continue
  for title,path,project in sorted(items,key=lambda i:i[0].lower()):
   row=Gtk.ListBoxRow();row.folder=path;row.project=project;h=Gtk.Box(spacing=12,margin=8);preview=path/project.get('preview','preview.jpg')
   if preview.is_file():
    try:h.pack_start(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(str(preview),110,65,True)),False,False,0)
    except GLib.Error:pass
   v=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4);l=Gtk.Label(label=title,xalign=0);l.set_ellipsize(Pango.EllipsizeMode.END);l.set_max_width_chars(55);v.pack_start(l,False,False,0);v.pack_start(Gtk.Label(label=project.get('type','')+' · '+path.name,xalign=0),False,False,0);h.pack_start(v,True,True,0);row.add(h);self.workshop_list.add(row)
  self.workshop_list.show_all();self.message(str(len(items))+' Workshop-Hintergründe gefunden.')
 def wallpaper_selected(self,_,row):
  if not row:return
