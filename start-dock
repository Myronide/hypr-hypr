#!/bin/sh
# Mit der Draconyx-Shell gibt es kein waybar: die Taskleiste kommt aus Quickshell.
[ -f "$HOME/.config/quickshell/draconyx/shell.qml" ] && [ "$AURORA_LEGACY_UI" != 1 ] && exit 0
mkdir -p "$HOME/.cache/aurora"
exec flock -w 3 "${XDG_RUNTIME_DIR:?}/aurora-dock.lock" sh -c '
    printf "%s\n" "$$" > "$XDG_RUNTIME_DIR/aurora-waybar.pid"
    exec waybar -c "$HOME/.config/waybar/config.jsonc" -s "$HOME/.config/waybar/style.css"
' >> "$HOME/.cache/aurora/waybar.log" 2>&1
